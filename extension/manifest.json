{
  "manifest_version": 3,
  "name": "Page to Grok Bot",
  "version": "0.1.0",
  "description": "Turn any page into a paste-ready Grok Bot charter. Does not sign in or create the Bot.",
  "homepage_url": "https://github.com/JYeswak/grok_bot_playground",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Make a Grok Bot from this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "minimum_chrome_version": "114"
}
