{
 "why": "a Windows client installed where Electron's userData rule says it should be",
 "sys_platform": "win32",
 "plant": [
  "appdata/Grok Bot"
 ],
 "env": {
  "HOME": "home",
  "APPDATA": "appdata"
 },
 "expect": {
  "os": "windows",
