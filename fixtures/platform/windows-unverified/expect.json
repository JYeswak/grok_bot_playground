  "capabilities": {
   "credential_read": "NOT_IMPLEMENTED",
   "scheduler_install": "NOT_IMPLEMENTED",
   "deployment_audit": "PARTIAL",
   "local_exec_policy": "AVAILABLE"
  },
  "why_mentions": "INFERRED",
