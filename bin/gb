# ---------------------------------------------------------------------------------------------
# Shared plumbing
# ---------------------------------------------------------------------------------------------
def emit(payload: Dict[str, Any], as_json: bool, human: str) -> None:
    """Stdout is data. `--json` prints the envelope; otherwise the rendered text. Never both,
    and never a log line — diagnostics go to stderr everywhere in this file."""
    print(json.dumps(payload, indent=1) if as_json else human.rstrip())


def envelope(command: str, **fields: Any) -> Dict[str, Any]:
    """Every JSON answer carries the same outer shape, so a consumer can branch on `status`
    before it knows anything else about the command it called."""
    return {
        "schema": f"gb-{command}/{CONTRACT_VERSION}",
        "tool": "gb",
        "version": VERSION,
        "command": command,
        "measured_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        **fields,
    }


REENTRY_ENV = "GB_IN_DOCTOR"


def probe(name: str, argv: List[str], timeout_s: float = 180.0, summary: str = "last") -> Dict[str, Any]:
    """Run one producer and classify it. A producer that is absent is ENVIRONMENT, not FAIL —
    a missing tool is not a red deployment, and conflating them sends the operator to the wrong
    problem. This is the doctor anti-pattern the standard names: never crash on a dead probe."""
    # Re-entry guard. `spine` runs the typed-spine proofs, and one of those proofs (t8) drives
    # this very CLI. Without a guard the chain is doctor -> spine -> selftest -> t8 -> doctor ->
    # spine -> ... bounded only by timeouts: measured 2026-09-11, a full `gb doctor` took 183s
    # and reported spine DOWN, which is a lie — the subsystem was fine, the tool was eating
    # itself. The guard is on the ENV, not on the one call site, so any future producer that
    # shells back into gb degrades to a skip instead of a hang.
    script = BIN / argv[0]
    if not script.exists():
        return {"subsystem": name, "status": "NOT_CONFIGURED", "severity": Severity.ERR.name,
                "detail": f"{argv[0]} is not in bin/ — nothing here can measure it", "exit": None}
    proc = run([sys.executable, str(script), *argv[1:]], timeout_s=timeout_s, cwd=ROOT,
               env={**os.environ, REENTRY_ENV: "1"})
    # Read the channel that carries the ANSWER. On success that is stdout: a producer's stderr
    # can legitimately contain expected-failure noise — `spine` runs proofs whose known-bad legs
    # print argparse errors on purpose, and surfacing one of those beside a PASS reads as a
    # contradiction. On failure, stderr is where the reason lives, so prefer it there.
    channel = (proc.out if proc.code == 0 else (proc.err or proc.out)) or ""
    tail = [ln for ln in channel.strip().splitlines() if ln.strip()]
    detail = ((tail[0] if summary == "first" else tail[-1]).strip()[:160]) if tail else "(no output)"
    if proc.timed_out:
        return {"subsystem": name, "status": "DOWN", "severity": Severity.CANCELLED.name,
                "detail": f"exceeded {timeout_s:.0f}s — stopped, so the answer is unknown",
                "exit": None}
    status = "PASS" if proc.code == 0 else ("DEGRADED" if proc.code == 1 else "DOWN")
    return {"subsystem": name, "status": status, "severity": proc.severity.name,
            "detail": detail, "exit": proc.code, "elapsed_s": proc.elapsed_s}


def newest(dirname: str) -> Optional[Dict[str, Any]]:
    d = ROOT / dirname
    rows = sorted(p for p in d.glob("*.json")) if d.is_dir() else []
    return read_json_capped(rows[-1]) if rows else None


# ---------------------------------------------------------------------------------------------
# Instance state — the difference between "not set up yet" and "set up and red"
#
# MEASURED 2026-09-11 on a fresh public clone (`git clone … /tmp/gbfresh`), nothing configured:
#
#     gb triage               rc=1  verdict ERROR · 24 checks · 22 not green
#     gb health               rc=1  ERROR · 22 check(s) not green
#     gb doctor --scope gate  rc=1  DOWN  gate  VERDICT ERROR (snapshot None, deployment None)
#     gb work                 rc=1  beads UNREACHABLE · issues EMPTY · 0 actionable
#
# 22 ERRORs is not 22 problems. It is ONE state — nothing has been measured on this machine yet
# — reported 22 times, and a new installer cannot tell it apart from "this tool is broken". The
# per-check remediations ("run bin/gb-market-snapshot.py") are 22 wrong answers to the one
# question he actually has, which is "what do I run FIRST". Exit 1 was wrong too: FINDINGS means
# measured-and-bad, and nothing here was measured.
#
# THE RULE. A working root is UNCONFIGURED exactly when BOTH hold:
#   (1) zero dated artifacts across every producer root — no producer has ever written here; AND
#   (2) no desktops.json — no desktop has ever been registered.
# Anything else is CONFIGURED, and a CONFIGURED root behaves exactly as it always has: one
# snapshot plus 21 gaps IS 21 real findings, and collapsing those into "not set up" would be the
# same lie pointed the other way. The rule is deliberately the WEAKEST evidence of configuration
# that exists (one artifact, OR one registered device) because the two mistakes are not
# symmetric: a false UNCONFIGURED hides real findings behind a setup nag, while a false
# CONFIGURED only shows the operator the check wall he already knows how to read.
# ---------------------------------------------------------------------------------------------
PRODUCER_ROOTS: Tuple[str, ...] = (
    "deployment", "inventory", "surface", "market", "usecases", "discovery", "mcp",
    "typecheck", "archive", "utilization", "gaps", "mine", "monitor", "bench",
)
DEVICE_REGISTRY = "desktops.json"
# Every producer here stamps its output `%Y-%m-%d…`: `deployment/2026-09-11T0008.json`,
# `inventory/<stamp>.<label>.json`, `typecheck/2026-09-11.json`, and `surface/2026-09-11/` —
# which is a DIRECTORY. Matching the dated prefix rather than globbing `*.json` is what lets one
# rule cover the files and the snapshot directory without a second special case.
_DATED = re.compile(r"^\d{4}-\d{2}-\d{2}")


@dataclasses.dataclass(frozen=True)
class InstanceState:
    """One working root's configuration state, and the evidence for it.

    `why` is carried rather than re-derived at each call site so the human block, the JSON
    envelope and `gb setup`'s verify step all quote the same sentence — a route that explains
    itself differently depending on which verb printed it is a route nobody trusts.
    """

    state: str
    measurements: int
    measured_roots: Tuple[str, ...]
    device_registry: bool
    why: str

    @property
    def unconfigured(self) -> bool:
        return self.state == "UNCONFIGURED"


def instance_state(root: pathlib.Path = ROOT) -> InstanceState:
    """Classify `root` as CONFIGURED or UNCONFIGURED. Pure read; see the rule above."""
    measured: List[str] = []
    total = 0
    for name in PRODUCER_ROOTS:
        d = root / name
        if not d.is_dir():
            continue
        dated = sum(1 for p in d.iterdir() if _DATED.match(p.name))
        if dated:
            measured.append(name)
            total += dated
    registry = (root / DEVICE_REGISTRY).is_file()
    if total or registry:
        parts = [f"{total} dated artifact(s) across {len(measured)} producer root(s)"]
        parts.append(f"{DEVICE_REGISTRY} {'present' if registry else 'absent'}")
        return InstanceState("CONFIGURED", total, tuple(measured), registry, "; ".join(parts))
    return InstanceState(
        "UNCONFIGURED", 0, (), False,
        f"no producer has ever written here (0 dated artifacts across {len(PRODUCER_ROOTS)} "
        f"producer roots) and there is no {DEVICE_REGISTRY}")


def route_unconfigured(command: str, as_json: bool, st: InstanceState) -> int:
    """The ONE block an unconfigured root gets, in place of the per-check wall.

    Exit 3 ENVIRONMENT, never 1 FINDINGS: 1 means it ran and the answer is bad, and nothing here
    was measured, so there is no answer yet — this machine cannot run the check. And the JSON
    carries `state`/`next_command` instead of an empty result set, because a consumer handed
    `checks: []` reads it as green. That is the exact failure `cmd_triage` already refuses for a
    zero-check board, and EMPTY must not be allowed to collapse into UNCONFIGURED here either.

    THE PLATFORM CAVEAT, added in wave 5. "Run `gb setup --apply`" is the right next command on
    macOS and a WRONG one on Linux: setup will register the desktop, fail to find a support
    directory at a path this repo only inferred, and leave the operator exactly where he
    started with one more artifact. So when the platform is not SUPPORTED the route says that
    FIRST and points at `gb platform`. His real problem is not that he has not set up yet; it
    is that nobody has ever verified this tool on his operating system.
    """
    plat = platform_support()
    caveat = plat.status != "SUPPORTED"
    payload = envelope(
        command,
        state=st.state,
        configured=False,
        measured=False,
        verdict=None,
        why=st.why,
        platform={"os": plat.os, "status": plat.status, "why": plat.why,
                  "support_dir": str(plat.support_dir) if plat.support_dir else None,
                  "support_dir_exists": plat.support_dir_exists},
        next_command="gb platform" if caveat else "gb setup --apply",
        commands=(["gb platform"] if caveat else []) + ["gb setup", "gb setup --apply"],
        evidence={"root": str(ROOT), "producer_roots": list(PRODUCER_ROOTS),
                  "dated_artifacts": st.measurements, "device_registry": st.device_registry},
    )
    human = [
        "UNCONFIGURED · nothing has been measured in this root yet — not a red deployment, and "
        "not a broken tool",
        "",
        f"  {st.why}.",
        f"  `gb {command}` judges artifacts on disk. There are none, so there is nothing to",
        "  judge: the 22 check ERRORs you would otherwise see are one state, not 22 problems.",
    ]
    if caveat:
        human += [
            "",
            f"  AND FIRST: this is {plat.os}, which this tool reports {plat.status}.",
            f"  {plat.why}.",
            "  `gb setup --apply` would register this desktop and then find nothing to measure",
            "  at a path nobody here has verified. Read `gb platform` before you run it.",
        ]
    human += ["", "next:"]
    if caveat:
        human += ["  gb platform               what this operating system can and cannot do here"]
    human += [
        "  gb setup                  what configuring this machine would do (writes nothing)",
        "  gb setup --apply          do it: register this desktop, then take the first",
        "                            measurements",
    ]
    emit(payload, as_json, "\n".join(human))
    return EXIT_ENVIRONMENT


# ---------------------------------------------------------------------------------------------
# Verbs
# ---------------------------------------------------------------------------------------------
def cmd_triage(a: TriageArgs) -> int:
    """The mega-command: one call, four slices, and the commands to act on them."""
    st = instance_state()
    if st.unconfigured:
        return route_unconfigured("triage", a.json, st)
    if a.check is not None:
        return _passthrough(
            [sys.executable, str(BIN / "gb-triage-check.py"), a.check]
            + (["--json"] if a.json else []),
            budget_s=300, label="triage-check",
        )
    proc = run([sys.executable, str(BIN / "gb-surface-gate.py"), "--json"], timeout_s=180, cwd=ROOT)
    if not (proc.out or "").strip():
        print("gb: the gate produced no output — run `gb doctor --scope gate`", file=sys.stderr)
        return EXIT_ENVIRONMENT
    try:
        board = json.loads(proc.out)
    except ValueError:
        print("gb: the gate's --json did not parse; run `gb doctor --scope gate`", file=sys.stderr)
        return EXIT_ENVIRONMENT

    results = board.get("checks") or []
    if not results:
        # Positive control. An empty check list is a BROKEN READ, never a clean board — this
        # exact bug shipped in the first cut of this file (it read `results`, the gate emits
        # `checks`) and reported verdict-clean against a board with two REDs on it.
        print("gb: the gate returned zero checks — that is a broken read, not a green board.\n"
              "    run: python3 bin/gb-surface-gate.py --json | jq '.checks | length'",
              file=sys.stderr)
        return EXIT_ENVIRONMENT
    red = [r for r in results if r.get("verdict") in ("RED", "ERROR")]
    cov = read_json_capped(ROOT / "coverage-floor.json") or {}
    commands = [f"gb why {r['check']}" for r in red[:5]] or ["gb health --json"]
    payload = envelope(
        "triage",
        verdict=board.get("verdict"),
        quick_ref={
            "checks": len(results),
            "red": len(red),
            "coverage_floor": cov.get("covered"),
            "snapshot": board.get("snapshot"),
        },
        red=[{"check": r["check"], "verdict": r["verdict"], "detail": r.get("detail", "")[:200]}
             for r in red],
        recommendations=[f"{r['check']}: {r.get('detail', '')[:120]}" for r in red],
        commands=commands,
    )
    human = [f"verdict {board.get('verdict')} · {len(results)} checks · {len(red)} not green"]
    human += [f"  {r['verdict']:<6}{r['check']:<32}{r.get('detail','')[:80]}" for r in red]
    human += ["", "next:"] + [f"  {c}" for c in commands]
    emit(payload, a.json, "\n".join(human))
    return EXIT_FINDINGS if red else EXIT_OK


# ---------------------------------------------------------------------------------------------
# `gb work` — the work-tracking read
#
# THE RULE THIS VERB EXISTS TO KEEP. A substrate that could not be read is UNREACHABLE; a
# substrate that was read and holds nothing is EMPTY. Collapsing those two into "0 items" is the
# failure this repo was built around (`gbtypes.Cell` keeps EMPTY apart from UNMEASURED for the
# coverage ledger for the same reason, and `cmd_triage` refuses to call a zero-check board
# green). An operator who is told "no work" when the truth is "I could not look" stops looking.
# ---------------------------------------------------------------------------------------------
@dataclasses.dataclass(frozen=True)
class Substrate:
    """One work-tracking substrate's read: the three-valued status, plus what it yielded.

    `status` is OK | EMPTY | UNREACHABLE and nothing else. `remediation` is populated exactly
    when UNREACHABLE, because an unreachable substrate whose fix is unstated is a dead end.
    `notes` carries degradations that are NOT unreachability — the listing was read but a
    secondary probe (readiness, orphans) was not, so the ranking is weaker than it looks.
    """

    name: str
    status: str
    detail: str
    items: Tuple[Dict[str, Any], ...] = ()
    remediation: Optional[str] = None
    notes: Tuple[str, ...] = ()


def _as_int(value: Any, default: int) -> int:
    """Coerce a JSON number-or-string to int without letting a surprise shape raise. A producer
    that changes `priority: 1` to `priority: "1"` must not crash the triage read."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def _age_days(stamp: Optional[str]) -> Optional[float]:
    """Days since an ISO-8601 instant, or None when it cannot be read.

    None is the answer for absent AND unparseable on purpose: in both cases the age is unknown,
    and an unknown age must not be silently rendered as 0 (fresh) by a staleness check.
    `br` and `gh` both emit a trailing `Z`, which `fromisoformat` rejects before 3.11.
    """
    if not stamp:
        return None
    try:
        when = dt.datetime.fromisoformat(stamp.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    if when.tzinfo is None:
        when = when.replace(tzinfo=dt.timezone.utc)
    return round((dt.datetime.now(dt.timezone.utc) - when).total_seconds() / 86400.0, 1)


def _rows(text: str) -> Optional[List[Dict[str, Any]]]:
    """Rows out of a producer's JSON, accepting both envelope shapes in use.

    `br list` answers `{"issues": [...]}`; `br ready`, `br blocked`, `br orphans` and
    `gh issue list` answer a bare array. None means it did not parse or was not either shape —
    which is a BROKEN READ, distinct from the empty array this returns as `[]`.
    """
    try:
        doc = json.loads(text)
    except ValueError:
        return None
    if isinstance(doc, dict):
        inner = doc.get("issues")
        return [r for r in inner if isinstance(r, dict)] if isinstance(inner, list) else None
    if isinstance(doc, list):
        return [r for r in doc if isinstance(r, dict)]
    return None


def _br_ids(exe: str, sub: str) -> Optional[Set[str]]:
    """The id set of one `br` triage view, or None when that view could not be read. None is
    load-bearing: it degrades the ranking to 'readiness unknown' instead of 'not ready'."""
    proc = run([exe, *BR_READONLY, sub, "--json"], timeout_s=60, cwd=ROOT)
    if proc.timed_out or proc.code != 0:
        return None
    rows = _rows(proc.out)
    return None if rows is None else {str(r["id"]) for r in rows if r.get("id")}


def _unreachable(name: str, detail: str, remediation: str) -> Substrate:
    return Substrate(name=name, status="UNREACHABLE", detail=detail, remediation=remediation)


def _tool_failure(proc: Any, what: str, remediation: str, name: str) -> Optional[Substrate]:
    """Map a finished child onto UNREACHABLE, or None when it succeeded. Timed-out is its own
    sentence because a killed probe did not answer — `Severity.CANCELLED`, not ERR."""
    if proc.timed_out:
        return _unreachable(name, f"`{what}` was stopped on its deadline — the substrate's "
                                  f"contents are unknown, not empty", remediation)
    if proc.code != 0:
        why = next((ln.strip() for ln in (proc.err or proc.out).splitlines() if ln.strip()),
                   "(no output)")
        return _unreachable(name, f"`{what}` exited {proc.code}: {why[:130]}", remediation)
    return None


def _read_beads() -> Substrate:
    """The bead ledger, plus the three secondary views the reliability checks need.

    Closed beads are kept in `items`: the `status_contradiction` check needs them, because a
    bead that `br list` calls closed while `br ready` still offers it is precisely the kind of
    ledger drift that makes a triage list untrustworthy.
    """
    exe = shutil.which(BEADS_TOOL)
    if exe is None:
        return _unreachable(
            "beads",
            f"`{BEADS_TOOL}` is not on PATH, so the bead ledger could not be read — that is "
            f"not the same fact as an empty ledger",
            'export PATH="$HOME/.local/bin:$PATH"   # br is installed there on this machine')
    listing = run([exe, *BR_READONLY, "list", "--status", "all", "--json"], timeout_s=60, cwd=ROOT)
    failed = _tool_failure(listing, f"{BEADS_TOOL} list", f"{BEADS_TOOL} doctor", "beads")
    if failed is not None:
        return failed
    rows = _rows(listing.out)
    if rows is None:
        return _unreachable("beads", f"`{BEADS_TOOL} list --json` did not parse as an issue "
                                     f"listing — the ledger is unreadable, not empty",
                            f"{BEADS_TOOL} list --status all --json | jq .")

    ready, blocked, orphans = (_br_ids(exe, v) for v in ("ready", "blocked", "orphans"))
    notes = tuple(
        f"`{BEADS_TOOL} {view}` could not be read, so {what} is unknown for every bead"
        for view, missing, what in (("ready", ready is None, "readiness"),
                                    ("blocked", blocked is None, "blockedness"),
                                    ("orphans", orphans is None, "commit-orphan state"))
        if missing)

    items: List[Dict[str, Any]] = []
    for row in rows:
        ident = str(row.get("id") or "")
        if not ident:
            continue
        labels = [str(x) for x in (row.get("labels") or []) if isinstance(x, (str, int))]
        items.append({
            "source": "beads",
            "id": ident,
            "title": str(row.get("title") or "")[:120],
            "status": str(row.get("status") or "unknown"),
            "priority": _as_int(row.get("priority"), NEUTRAL_PRIORITY),
            "ready": None if ready is None else ident in ready,
            "blocked": None if blocked is None else ident in blocked,
            "orphan": None if orphans is None else ident in orphans,
            "deferred": bool(row.get("defer_until")),
            "dependents": _as_int(row.get("dependent_count"), 0),
            "external_ref": (str(row["external_ref"]) if row.get("external_ref") else None),
            "labels": labels,
            "updated_at": row.get("updated_at"),
            "age_days": _age_days(row.get("updated_at")),
            "command": f"{BEADS_TOOL} show {ident}",
        })
    live = [i for i in items if i["status"] == "open"]
    closed = len(items) - len(live)
    if not live:
        return Substrate("beads", "EMPTY",
                         f"read the ledger: {len(items)} bead(s), none open ({closed} closed)",
                         tuple(items), notes=notes)
    return Substrate("beads", "OK",
                     f"read the ledger: {len(live)} open, {closed} closed",
                     tuple(items), notes=notes)


def _read_issues(fetch: int) -> Substrate:
    """The public repo's issues, via `gh`.

    Three separate UNREACHABLE causes, each with its own remediation, because "install it",
    "log in" and "the API said no" are three different mornings. `shutil.which` first is not
    belt-and-braces: `gbtypes.run` does not catch `FileNotFoundError`, so probing a missing
    binary would traceback — and `probe`'s doctrine here is that a dead probe never crashes.
    """
    exe = shutil.which("gh")
    if exe is None:
        return _unreachable(
            "issues",
            "`gh` is not on PATH, so the issue tracker could not be read — this is NOT a report "
            "of zero issues",
            "brew install gh && gh auth login")
    auth = run([exe, "auth", "status"], timeout_s=30, cwd=ROOT)
    failed = _tool_failure(auth, "gh auth status", "gh auth login", "issues")
    if failed is not None:
        return failed
    listing = run([exe, "issue", "list", "--repo", ISSUES_REPO, "--json", ISSUE_FIELDS,
                   "--limit", str(max(1, fetch))], timeout_s=60, cwd=ROOT)
    # Remediation is the NEXT probe, not the command that just failed: `gh repo view` separates
    # "the slug is wrong or private to you" from "the API said no", which is the fork here.
    failed = _tool_failure(listing, f"gh issue list --repo {ISSUES_REPO}",
                           f"gh repo view {ISSUES_REPO}", "issues")
    if failed is not None:
        return failed
    rows = _rows(listing.out)
    if rows is None:
        return _unreachable("issues", "`gh issue list --json` did not parse as an array — the "
                                      "tracker is unreadable, not empty",
                            f"gh issue list --repo {ISSUES_REPO} --json {ISSUE_FIELDS}")

    items: List[Dict[str, Any]] = []
    for row in rows:
        number = _as_int(row.get("number"), 0)
        if not number:
            continue
        labels = [str(lb.get("name")) for lb in (row.get("labels") or [])
                  if isinstance(lb, dict) and lb.get("name")]
        folded = {lb.lower() for lb in labels}
        items.append({
            "source": "issues",
            "id": f"#{number}",
            "number": number,
            "title": str(row.get("title") or "")[:120],
            "status": str(row.get("state") or "unknown").lower(),
            "priority": min((ISSUE_LABEL_PRIORITY[lb] for lb in folded
                             if lb in ISSUE_LABEL_PRIORITY), default=NEUTRAL_PRIORITY),
            "ready": not (folded & NOT_READY_LABELS),
            "blocked": bool(folded & NOT_READY_LABELS),
            "orphan": None,
            "deferred": False,
            "dependents": 0,
            "external_ref": None,
            "labels": labels,
            "updated_at": row.get("updatedAt"),
            "age_days": _age_days(row.get("updatedAt")),
            "command": f"gh issue view {number} --repo {ISSUES_REPO}",
        })
    live = [i for i in items if i["status"] == "open"]
    if not live:
        return Substrate("issues", "EMPTY",
                         f"read {ISSUES_REPO}: {len(items)} issue(s), none open", tuple(items))
    return Substrate("issues", "OK", f"read {ISSUES_REPO}: {len(live)} open", tuple(items))


def _rank_key(item: Dict[str, Any]) -> Tuple[int, int, int, str]:
    """The ranking. LEXICOGRAPHIC, deliberately — not a weighted score.

    There is no measurement in this repo that would justify weights, and a made-up 0.4/0.3/0.2
    is a number an operator cannot argue with. A sort key he can: each field is a fact one of
    the two substrates already publishes, in the order that decides a pick-up.

      1. actionable-first — `br ready` membership (or, for an issue, the absence of a
         blocked/waiting label). An item you cannot start does not belong at the top of a list
         of what to start. Readiness that could NOT be verified ranks with the unready, because
         an unverified claim is not a green light.
      2. priority — `br`'s own 0..4 field, taken at face value; the author's declared urgency is
         better evidence than anything this verb could re-derive. Issues use the declared label
         table above and fall to neutral when no label matches.
      3. dependents, descending — `dependent_count` from `br`: work that unblocks other work is
         worth more than leaf work. Issues have no such field and score 0.
      4. oldest-updated first — pure tiebreak. Staleness deliberately does NOT boost rank: a
         forgotten item is not more urgent, it is more forgotten, and it is reported as a
         reliability finding instead of being smuggled into the ordering.
    """
    return (
        0 if item.get("ready") is True else 1,
        _as_int(item.get("priority"), NEUTRAL_PRIORITY),
        -_as_int(item.get("dependents"), 0),
        str(item.get("updated_at") or "9999"),
    )


_ISSUE_REF = re.compile(r"(?:#|/issues/)(\d+)\s*$")


def _finding(cls: str, severity: Severity, detail: str, command: str, **extra: Any) -> Dict[str, Any]:
    return {"class": cls, "severity": severity.name, "detail": detail, "command": command, **extra}


def _reliability(subs: Sequence[Substrate]) -> List[Dict[str, Any]]:
    """Reasons this ranking might be lying, as first-class findings.

    Five classes, every one computed from a field `br` or `gh` actually returns. What is NOT
    here is documented by its absence: there is no "closed here, open there" check that does not
    go through `external_ref`, because neither substrate carries any other cross-link.
    """
    findings: List[Dict[str, Any]] = []
    for sub in subs:
        if sub.status == "UNREACHABLE":
            findings.append(_finding(
                "substrate_unreachable", Severity.ERR,
                f"{sub.name}: {sub.detail}", sub.remediation or "", substrate=sub.name))
        for note in sub.notes:
            findings.append(_finding(
                "unverified_readiness", Severity.CANCELLED, f"{sub.name}: {note}",
                f"{BEADS_TOOL} doctor", substrate=sub.name))

    items = [i for sub in subs for i in sub.items]
    issue_state = {i["id"]: i["status"] for i in items if i["source"] == "issues"}
    for item in items:
        ident, status = item["id"], item["status"]
        # (a) drift inside br: the ledger calls it closed, the ready view still offers it.
        if item["source"] == "beads" and status != "open" and item.get("ready") is True:
            findings.append(_finding(
                "status_contradiction", Severity.ERR,
                f"{ident} is {status} in `{BEADS_TOOL} list` but `{BEADS_TOOL} ready` still "
                f"offers it — one of the two views is wrong",
                f"{BEADS_TOOL} show {ident}", id=ident))
        # (a') drift across substrates, via the only cross-link either side publishes.
        ref = item.get("external_ref")
        if item["source"] == "beads" and isinstance(ref, str):
            hit = _ISSUE_REF.search(ref)
            linked = issue_state.get(f"#{hit.group(1)}") if hit else None
            if linked is not None and (linked == "open") != (status == "open"):
                findings.append(_finding(
                    "status_contradiction", Severity.ERR,
                    f"{ident} is {status} but its linked issue #{hit.group(1) if hit else '?'} "
                    f"is {linked} — the two ledgers disagree about the same work",
                    f"{BEADS_TOOL} show {ident}", id=ident))
        # Open, but offered by neither triage view. Deferral is the legitimate reason and is
        # excluded by `defer_until`; what is left is invisible to every way of asking for work.
        if (status == "open" and not item.get("deferred")
                and item.get("ready") is False and item.get("blocked") is False):
            findings.append(_finding(
                "ledger_limbo", Severity.ERR,
                f"{ident} is open but appears in neither `{BEADS_TOOL} ready` nor "
                f"`{BEADS_TOOL} blocked` and is not deferred — no triage view will ever show it",
                f"{BEADS_TOOL} show {ident}", id=ident))
        if item.get("orphan") is True:
            findings.append(_finding(
                "orphan_reference", Severity.ERR,
                f"{ident} is referenced by a commit but is still open — the work may be done "
                f"and the ledger not updated",
                f"{BEADS_TOOL} show {ident}", id=ident))
        age = item.get("age_days")
        if status == "open" and isinstance(age, float) and age > STALE_DAYS:
            findings.append(_finding(
                "stale_item", Severity.ERR,
                f"{ident} has not been touched in {age:.0f}d (threshold {STALE_DAYS:.0f}d, "
                f"two weekly ticks)", item["command"], id=ident, age_days=age))
    return findings


def cmd_work(a: WorkArgs) -> int:
    """What to pick up next across both work-tracking substrates, and whether to trust it."""
    if a.source is not None and a.source not in ("beads", "issues"):
        print(f"gb: unknown --source {a.source!r}. Known: beads, issues (omit for both)\n"
              f"    try: gb work --source beads", file=sys.stderr)
        return EXIT_USAGE
    # After the usage check (a bad flag is still USAGE on a fresh clone) and before the reads:
    # an unconfigured root has no ranking to offer, and `beads UNREACHABLE · 0 actionable` is
    # the wrong sentence for "you have not set up yet".
    st = instance_state()
    if st.unconfigured:
        return route_unconfigured("work", a.json, st)
    wanted: Tuple[str, ...] = (a.source,) if a.source else ("beads", "issues")
    limit = max(1, a.limit)

    subs = [_read_beads() if name == "beads" else _read_issues(max(limit, 50))
            for name in wanted]
    readable = [s for s in subs if s.status != "UNREACHABLE"]
    if not readable:
        # Nothing could be read at all. This is the case that MUST NOT render as "no work":
        # exit 3 says "this machine cannot answer the question", which is what happened. The
        # human channel says the same thing in words, because "0 items" on stdout is the lie.
        for sub in subs:
            print(f"gb: {sub.name} UNREACHABLE — {sub.detail}\n"
                  f"    fix: {sub.remediation}", file=sys.stderr)
        findings = _reliability(subs)
        human = [f"UNKNOWN · {len(subs)} substrate(s), none readable — this is NOT zero work", ""]
        human += [f"  {s.name:<8}UNREACHABLE  {s.detail}" for s in subs]
        human += ["", "next:"] + [f"  {s.remediation}" for s in subs if s.remediation]
        emit(envelope("work",
                      sources={s.name: {"status": s.status, "detail": s.detail,
                                        "remediation": s.remediation, "items": 0,
                                        "notes": list(s.notes)} for s in subs},
                      ranking=None, totals={"actionable": None, "shown": 0,
                                            "reliability_findings": len(findings)},
                      items=[], reliability=findings,
                      commands=[s.remediation for s in subs if s.remediation]),
             a.json, "\n".join(human))
        return EXIT_ENVIRONMENT

    actionable = sorted((i for s in subs for i in s.items if i["status"] == "open"),
                        key=_rank_key)
    shown = actionable[:limit]
    findings = _reliability(subs)
    commands = [i["command"] for i in shown[:3]] + [
        f["command"] for f in findings if f["command"]][:3] or ["gb triage"]

    payload = envelope(
        "work",
        sources={s.name: {"status": s.status, "detail": s.detail, "remediation": s.remediation,
                          "items": len([i for i in s.items if i["status"] == "open"]),
                          "notes": list(s.notes)} for s in subs},
        ranking={"method": "lexicographic",
                 "keys": ["actionable_first", "priority_asc", "dependents_desc",
                          "updated_at_asc"],
                 "note": "no weighted score: every key is a field br or gh publishes. Issue "
                         "priority comes from a declared label table, not a measurement.",
                 "stale_days": STALE_DAYS},
        totals={"actionable": len(actionable), "shown": len(shown),
                "reliability_findings": len(findings)},
        items=shown,
        reliability=findings,
        commands=commands,
    )

    head = " · ".join(f"{s.name} {s.status}" for s in subs)
    human = [f"{head} · {len(actionable)} actionable · {len(findings)} reliability finding(s)", ""]
    for rank, item in enumerate(shown, 1):
        # Truncate the id INTO its column: a 40-char bead id that overflows collides with the
        # title and the table stops being one. The untruncated id is in --json and in `command`.
        flag = "" if item.get("ready") is True else ("BLOCK " if item.get("blocked") else "?rdy  ")
        age = item.get("age_days")
        age_txt = f"{age:.0f}d" if isinstance(age, float) else "?"
        human.append(f"  {rank:>2}. p{item['priority']} {item['source']:<7}"
                     f"{item['id'][:34]:<35}{age_txt:>5}  {flag}{item['title'][:42]}")
    if not shown:
        human.append("  (nothing actionable in the substrates that could be read)")
    if findings:
        human += ["", "reliability:"]
        human += [f"  {f['class']:<22}{f['detail'][:96]}" for f in findings[:10]]
        if len(findings) > 10:
            human.append(f"  ... and {len(findings) - 10} more (use --json)")
    for sub in subs:
        if sub.status == "UNREACHABLE":
            human += ["", f"  {sub.name} could NOT be read — this is not a count of zero.",
                      f"  fix: {sub.remediation}"]
    human += ["", "next:"] + [f"  {c}" for c in commands]
    emit(payload, a.json, "\n".join(human))
    return EXIT_FINDINGS if (shown or findings) else EXIT_OK


def cmd_doctor(a: DoctorArgs) -> int:
    # Re-entry is refused at the FAN-OUT, not per subsystem. The first cut keyed the guard on
    # the name "spine", which bounded the recursion at depth 1 rather than removing it —
    # measured 2026-09-11: gbtypes-selftest costs 16.9s unguarded vs 8.6s guarded, so ~8.3s of
    # a `gb doctor` was recursion depth, not proof. Worse, a name-keyed guard protects exactly
    # one subsystem: adding a `bench` subsystem that shells back into gb would have recursed
    # with nothing to stop it. Keying on "am I already inside a doctor run" is the property we
    # actually want, and it holds for subsystems nobody has written yet.
    if os.environ.get(REENTRY_ENV):
        print("gb: refusing to run doctor inside a doctor — a producer this run spawned is "
              "shelling back into the CLI.\n"
              "    run it on its own:  gb doctor" + (f" --scope {a.scope}" if a.scope else ""),
              file=sys.stderr)
        return EXIT_ENVIRONMENT

    scopes = {a.scope: SUBSYSTEMS[a.scope]} if a.scope in SUBSYSTEMS else (
        None if a.scope else SUBSYSTEMS)
    if scopes is None:
        print(f"gb: unknown scope {a.scope!r}. Known: {', '.join(SUBSYSTEMS)}\n"
              f"    try: gb doctor --scope {sorted(SUBSYSTEMS)[0]}", file=sys.stderr)
        return EXIT_USAGE
    # The apparatus is not the deployment, but on an unconfigured root every subsystem probe
    # reports on artifacts that do not exist yet — `DOWN gate VERDICT ERROR (snapshot None)` is
    # a true sentence about a question nobody asked. Route first.
    st = instance_state()
    if st.unconfigured:
        return route_unconfigured("doctor", a.json, st)
    rows = [probe(n, argv, summary=how) for n, (argv, _why, how) in scopes.items()]
    bad = [r for r in rows if r["status"] not in ("PASS",)]
    payload = envelope("doctor", subsystems=rows, failing=len(bad))
    human = [f"  {r['status']:<15}{r['subsystem']:<10}{r['detail'][:90]}" for r in rows]
    human.append("")
    human.append(f"{len(rows) - len(bad)}/{len(rows)} subsystem(s) pass"
                 + ("" if not bad else f" — `gb repair --scope <x>` or `gb why <check>`"))
    emit(payload, a.json, "\n".join(human))
    return EXIT_FINDINGS if bad else EXIT_OK


def cmd_health(a: HealthArgs) -> int:
    def once() -> int:
        st = instance_state()
        if st.unconfigured:
            # Inside `once()`, so `--watch` on a fresh clone keeps printing the route rather
            # than 22 ERRORs a minute until someone runs setup.
            return route_unconfigured("health", a.json, st)
        board = newest("deployment")
        gate = run([sys.executable, str(BIN / "gb-surface-gate.py"), "--json"],
                   timeout_s=180, cwd=ROOT)
        verdict = "UNKNOWN"
        red = 0
        if (gate.out or "").strip():
            try:
                doc = json.loads(gate.out)
                verdict = doc.get("verdict", "UNKNOWN")
                checks = doc.get("checks") or []
                if not checks:
                    verdict = "UNREADABLE"
                red = sum(1 for r in checks if r.get("verdict") != "GREEN")
            except ValueError:
                verdict = "UNPARSEABLE"
        payload = envelope("health", verdict=verdict, not_green=red,
                           deployment_measured_at=(board or {}).get("measured_at"))
        emit(payload, a.json, f"{verdict} · {red} check(s) not green")
        return EXIT_OK if verdict == "GREEN" else EXIT_FINDINGS

    if not a.watch:
        return once()
    while True:  # cancel-correct: SIGINT unwinds through gbtypes.main -> exit 130
        rc = once()
        time.sleep(max(1, a.interval))
    return rc


# ---------------------------------------------------------------------------------------------
# `gb setup` — the one step a fresh clone is routed to
#
# This is the ONLY verb besides `gb repair` that writes, and the same gate applies: dry-run by
# default, `--apply` to act. Two properties it is built around.
#
# IDEMPOTENCE. Device identity is the HOSTNAME, not the label — a label is a nickname an
# operator may retype differently on the second run, and matching on it would put the same Mac
# in `desktops.json` twice. A hostname that is already registered under the same label is a
# no-op, so `--apply` twice leaves one row and re-fetches nothing.
#
# NEVER HALF-CONFIGURE. Writing `desktops.json` is by itself enough to flip this root to
# CONFIGURED (see `instance_state`), which means writing it on a machine that cannot then MEASURE
# anything would hand the operator the check wall back with a registry on top — the precise
# failure this wave exists to remove. So when preflight proves no measurement can follow (no
# network AND no desktop app), `--apply` REFUSES (exit 5) and writes nothing at all.
# ---------------------------------------------------------------------------------------------
# Presence is probed, never the value. `bin/gb-pull-inventory.py` is the only thing that reads
# the password out of this item, and it is a human-gated read (macOS prompts for Allow).
KEYCHAIN_SERVICE, KEYCHAIN_ACCOUNT = "Grok Bot Safe Storage", "Grok Bot Key"
# The cheapest honest liveness probe for the vendor surface: it is the index
# `bin/gb-surface-snapshot.py` fetches first, so reaching it is the same fact as "the snapshot
# can run", not a proxy for it.
DOCS_PROBE_URL = "https://docs.x.ai/llms.txt"
# A label becomes a filename component (`inventory/<stamp>.<label>.json`), so it is constrained
# to what a filename and a JSON key can both hold without quoting.
LABEL_OK = re.compile(r"^[a-z0-9][a-z0-9._-]{0,31}$")
SETUP_PRODUCERS: Tuple[str, ...] = (
    "gb-surface-snapshot.py", "gb-deployment-audit.py", "gb-pull-inventory.py")
REGISTRY_WHY = (
    "Auto-review rules and Execution-on-Local-Computer are stored PER DESKTOP and synced only to "
    "that desktop's Grok Bot computer (https://cursor.com/docs/grok-bot/security). Every desktop "
    "that can hold those settings must therefore be measured on its own. This registry is what "
    "makes 'we forgot that laptop' a RED instead of a silence.")


def _step(step: str, status: str, detail: str, remediation: Optional[str] = None,
          **extra: Any) -> Dict[str, Any]:
    """One setup step's row. `status` is OK | ABSENT | NOT_IMPLEMENTED | PLANNED | SKIPPED |
    FAILED and nothing else; `remediation` is populated exactly when the row is not OK or
    PLANNED, because a step that failed without naming its fix is the dead end this verb exists
    to replace.

    NOT_IMPLEMENTED is not a synonym for ABSENT. ABSENT means the thing could be here and is
    not — install the app, sign in, and the row turns OK. NOT_IMPLEMENTED means no sequence of
    actions on THIS operating system makes this tool able to do it, which is a different
    sentence and a different next step.
    """
    return {"step": step, "status": status, "detail": detail, "remediation": remediation, **extra}


def _probe_keychain(plat: Platform) -> Dict[str, Any]:
    """Is the desktop client's safeStorage keychain item PRESENT? Presence only.

    `security find-generic-password` WITHOUT `-w` prints the item's ATTRIBUTES and never its
    password, so this probe cannot leak the secret even by accident, and it does not trip the
    per-application ACL prompt that reading the password does (measured 2026-09-11: exit 0, no
    prompt). Its stdout is discarded regardless — this function returns a code and a sentence.

    `plat` is a parameter, not a module read, for one reason: it is what lets
    `gb platform --selftest` drive this exact function with a Windows-shaped or Android-shaped
    platform on this Mac and prove the refusal path answers instead of raising. A gate nothing
    can exercise is a gate nobody knows the shape of.
    """
    cap = unavailable(plat, "credential_read")
    if cap is not None:
        # The honest refusal. Not ABSENT — there is no keychain item to be absent, because this
        # platform does not store the session in a keychain at all. Returning OK here, or an
        # empty success, would let `setup` go on to run the inventory pull and fail inside a
        # subprocess with a `command not found`.
        return _step("keychain", "NOT_IMPLEMENTED", f"{plat.os}: {cap.detail}", cap.remediation,
                     platform=plat.os, platform_status=plat.status)
    if shutil.which("security") is None:
        return _step("keychain", "ABSENT",
                     "`security` is not on PATH — even on macOS the desktop client's session "
                     "cannot be read without it",
                     "this is a stripped macOS environment; run `gb setup --apply` on the "
                     "desktop that runs the Grok Bot app")
    proc = run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
                "-a", KEYCHAIN_ACCOUNT], timeout_s=30, cwd=ROOT)
    if proc.timed_out:
        return _step("keychain", "FAILED",
                     "the keychain probe was stopped on its deadline — presence is UNKNOWN, "
                     "which is not the same fact as absent",
                     "security find-generic-password -s 'Grok Bot Safe Storage' -a 'Grok Bot Key'")
    if proc.code != 0:
        return _step("keychain", "ABSENT",
                     f"no keychain item {KEYCHAIN_SERVICE!r}/{KEYCHAIN_ACCOUNT!r} (exit "
                     f"{proc.code}) — the Grok Bot desktop app has never signed in here",
                     "open the Grok Bot desktop app, sign in, then re-run `gb setup --apply`")
    return _step("keychain", "OK",
                 f"the {KEYCHAIN_SERVICE!r} item exists — presence only: no value was read, and "
                 f"this probe cannot print one")


def _probe_docs() -> Dict[str, Any]:
    """Can the vendor doc surface be reached? HEAD, so nothing is downloaded to decide it."""
    req = urllib.request.Request(DOCS_PROBE_URL, method="HEAD",
                                 headers={"user-agent": f"gb/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=15.0) as resp:
            code = int(getattr(resp, "status", 0) or 0)
    except urllib.error.HTTPError as exc:
        # UPSTREAM, not local: the network worked and the vendor said no.
        return _step("network", "FAILED",
                     f"{DOCS_PROBE_URL} answered HTTP {exc.code} — the vendor refused, nothing "
                     f"local is broken", f"curl -sSI {DOCS_PROBE_URL}")
    except Exception as exc:  # URLError, socket.timeout, ssl errors — all "cannot reach it"
        return _step("network", "ABSENT",
                     f"{DOCS_PROBE_URL} is unreachable ({type(exc).__name__}) — the vendor "
                     f"surface cannot be snapshotted from this machine",
                     f"check connectivity, then: curl -sSI {DOCS_PROBE_URL}")
    return _step("network", "OK", f"{DOCS_PROBE_URL} answered HTTP {code}")


def _preflight(plat: Platform) -> List[Dict[str, Any]]:
    """Every prerequisite `gb setup` has, each as its own row with its own remediation.

    Pure read, so it runs identically in dry-run and under `--apply` — the plan is only worth
    printing if it was measured, and a "plan" that guesses at its own prerequisites is prose.

    `platform` is the FIRST row because it is the first thing that can be wrong. Before this
    wave the rows below simply reported the macOS paths absent on a Linux box: five ABSENTs for
    one fact, and the one fact was never stated.
    """
    rows: List[Dict[str, Any]] = []
    rows.append(_step("platform",
                      "OK" if plat.status == "SUPPORTED" else
                      ("NOT_IMPLEMENTED" if plat.status == "UNSUPPORTED" else "ABSENT"),
                      f"{plat.os} ({plat.status}) — {plat.why}", plat.remediation,
                      platform=plat.os, platform_status=plat.status))
    v = sys.version_info
    ok39 = (v.major, v.minor) >= (3, 9)
    rows.append(_step("python", "OK" if ok39 else "ABSENT",
                      f"python {v.major}.{v.minor}.{v.micro}"
                      + ("" if ok39 else " — the producers here need 3.9 or newer"),
                      None if ok39 else "install python 3.9+ and re-run"))

    gone = [n for n in ("gbtypes.py", "gbargs.py") if not (BIN / n).is_file()]
    gone += [n for n in SETUP_PRODUCERS if not (BIN / n).is_file()]
    rows.append(_step(
        "cli", "OK" if not gone else "ABSENT",
        (f"gb {VERSION} imported its own typed spine (gbargs, gbtypes) — this process is the "
         f"proof — and all {len(SETUP_PRODUCERS)} producer(s) setup drives are in bin/")
        if not gone else f"bin/ is incomplete: {', '.join(gone)} missing",
        None if not gone else "re-clone the repo; a partial checkout cannot measure anything"))

    app = bool(plat.support_dir and plat.support_dir.is_dir())
    where = str(plat.support_dir) if plat.support_dir else "(this platform has no such directory)"
    rows.append(_step("desktop-app", "OK" if app else "ABSENT",
                      f"{where} exists — the local client's state can be audited"
                      if app else
                      f"{where} does not exist — the Grok Bot desktop app has never run "
                      f"on this machine, so there is no local deployment to audit"
                      + ("" if plat.status == "SUPPORTED" else
                         f" (and that path is {plat.path_source})"),
                      None if app else
                      ("install and launch the Grok Bot desktop app, then re-run "
                       "`gb setup --apply`" if plat.status == "SUPPORTED"
                       else f"see `gb platform`: {plat.remediation or 'this platform is not verified'}")))

    rows.append(_probe_keychain(plat))

    crypto = importlib.util.find_spec("cryptography") is not None
    rows.append(_step("crypto", "OK" if crypto else "ABSENT",
                      "the `cryptography` module is importable — the desktop session blob can "
                      "be decrypted" if crypto else
                      "`cryptography` is not importable, so bin/gb-pull-inventory.py cannot "
                      "decrypt the desktop session and the account read is impossible",
                      None if crypto else "python3 -m pip install cryptography"))

    rows.append(_probe_docs())
    return rows


def _device_label(explicit: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
    """(label, usage-error). An explicit label is validated, never silently rewritten; a derived
    one is sanitized, because the hostname is the tool's guess and it owns the consequences."""
    if explicit is not None:
        label = explicit.strip().lower()
        if not LABEL_OK.match(label):
            return None, (f"--device {explicit!r} is not a usable label. It becomes part of an "
                          f"artifact filename (inventory/<stamp>.<label>.json), so it must match "
                          f"{LABEL_OK.pattern}\n    try: gb setup --device studio")
        return label, None
    raw = socket.gethostname().split(".")[0]
    label = re.sub(r"[^a-z0-9._-]+", "-", raw.lower()).strip("-.")
    if not LABEL_OK.match(label):
        return None, (f"cannot derive a device label from hostname {raw!r}\n"
                      f"    try: gb setup --device studio")
    return label, None


def _plan_device(label: str) -> Tuple[Dict[str, Any], Optional[Dict[str, Any]]]:
    """What registering THIS machine would change, and the whole document that would replace
    `desktops.json`. A `None` document means there is nothing to write — that is the idempotent
    path, and it is decided on HOSTNAME so a re-typed label cannot duplicate a row."""
    host = socket.gethostname()
    path = ROOT / DEVICE_REGISTRY
    existing_any = read_json_capped(path)
    if path.is_file() and not isinstance(existing_any, dict):
        return (_step("device", "FAILED",
                      f"{DEVICE_REGISTRY} exists but does not read as a JSON object — refusing "
                      f"to overwrite a file this tool cannot parse",
                      f"inspect it: jq . {DEVICE_REGISTRY}"), None)
    existing: Dict[str, Any] = existing_any if isinstance(existing_any, dict) else {}
    rows = [d for d in (existing.get("desktops") or []) if isinstance(d, dict)]
    hit = next((d for d in rows if str(d.get("hostname") or "") == host), None)
    if hit is not None and str(hit.get("label") or "") == label:
        return (_step("device", "OK",
                      f"{label} ({host}) is already in {DEVICE_REGISTRY} alongside "
                      f"{len(rows) - 1} other desktop(s) — nothing to write",
                      device=label, hostname=host, desktops=len(rows)), None)
    kept = [d for d in rows if str(d.get("hostname") or "") != host]
    kept.append({"label": label, "hostname": host, "ssh": None,
                 "note": f"registered by `gb setup` on "
                         f"{dt.date.today().isoformat()}; audited locally"})
    doc = dict(existing)
    doc.setdefault("_why", REGISTRY_WHY)
    doc["host_of_record"] = existing.get("host_of_record") or label
    doc["desktops"] = kept
    doc.setdefault("not_a_desktop", [])
    verb = ("refresh the hostname row for" if hit is not None
            else ("create " + DEVICE_REGISTRY + " with" if not path.is_file() else "add"))
    return (_step("device", "PLANNED",
                  f"would {verb} {label} ({host}) — {len(kept)} desktop(s) after, "
                  f"host_of_record={doc['host_of_record']}",
                  device=label, hostname=host, desktops=len(kept)), doc)


def _run_producer(step: str, argv: List[str], timeout_s: float) -> Dict[str, Any]:
    """Drive one producer through the typed spine and classify it the way `probe` does."""
    shown = "python3 bin/" + " ".join(argv)
    proc = run([sys.executable, str(BIN / argv[0]), *argv[1:]], timeout_s=timeout_s, cwd=ROOT)
    if proc.timed_out:
        return _step(step, "FAILED",
                     f"`{shown}` exceeded {timeout_s:.0f}s — stopped, so whether it wrote "
                     f"anything is unknown", shown, command=shown, exit=None)
    channel = (proc.out if proc.code == 0 else (proc.err or proc.out)) or ""
    line = next((ln.strip() for ln in reversed(channel.splitlines()) if ln.strip()), "(no output)")
    if proc.code != 0:
        return _step(step, "FAILED", f"`{shown}` exited {proc.code}: {line[:160]}",
                     shown, command=shown, exit=proc.code)
    return _step(step, "OK", f"`{shown}` -> {line[:160]}", command=shown, exit=0,
                 elapsed_s=proc.elapsed_s)


def _already(root: str, pattern: str = "*") -> int:
    """How many DATED artifacts a producer root already holds. The idempotency predicate: setup
    takes a FIRST measurement, it is not a tick, so anything already measured is left alone and
    `bin/gb-weekly.sh` owns refreshing it. Without this, a second `--apply` would re-fetch 35
    vendor pages to learn nothing."""
    d = ROOT / root
    if not d.is_dir():
        return 0
    return sum(1 for p in d.glob(pattern) if _DATED.match(p.name))


def _measure(label: str, pre: Dict[str, str], apply: bool, plat: Platform) -> List[Dict[str, Any]]:
    """The first measurements a machine with no prior state can take, in dependency order.

    `gb-surface-snapshot.py` needs only the network. `gb-deployment-audit.py` needs the desktop
    app's support directory. `gb-pull-inventory.py` needs BOTH a registered desktop and a
    deployment audit (it calls `gblib.newest_audit` and dies without one) plus the keychain and
    `cryptography` — so it is reported SKIPPED with the named prerequisite rather than run and
    allowed to fail for a reason the operator has to decode from a traceback.
    """
    rows: List[Dict[str, Any]] = []

    def plan_or_run(step: str, argv: List[str], timeout_s: float, have: int,
                    where: str, blocker: Optional[str], fix: Optional[str]) -> Dict[str, Any]:
        shown = "python3 bin/" + " ".join(argv)
        if have:
            return _step(step, "OK",
                         f"already measured: {have} dated artifact(s) under {where} — setup "
                         f"takes the FIRST measurement and never re-fetches; "
                         f"bin/gb-weekly.sh refreshes it", command=shown, existing=have)
        if blocker is not None:
            return _step(step, "SKIPPED", f"cannot run `{shown}`: {blocker}", fix, command=shown)
        if not apply:
            return _step(step, "PLANNED", f"would run `{shown}`", None, command=shown)
        return _run_producer(step, argv, timeout_s)

    rows.append(plan_or_run(
        "surface", ["gb-surface-snapshot.py"], 900.0, _already("surface"), "surface/",
        None if pre.get("network") == "OK"
        else f"the doc surface is not reachable ({pre.get('network')})",
        f"curl -sSI {DOCS_PROBE_URL}"))
    rows.append(plan_or_run(
        "deployment", ["gb-deployment-audit.py"], 300.0, _already("deployment", "*.json"),
        "deployment/",
        None if pre.get("desktop-app") == "OK" else
        (f"{plat.support_dir} does not exist" if plat.support_dir
         else f"{plat.os} has no support directory for the audit to read"),
        ("install and launch the Grok Bot desktop app, then re-run `gb setup --apply`"
         if plat.status == "SUPPORTED" else "gb platform")))

    audited = any(r["step"] == "deployment" and r["status"] in ("OK", "PLANNED") for r in rows)
    blocker = next((why for ok, why in (
        (pre.get("keychain") == "OK",
         "the desktop client's keychain item is not present"
         if plat.capability("credential_read").available
         else f"the credential read is NOT_IMPLEMENTED on {plat.os} — see `gb platform`"),
        (pre.get("crypto") == "OK", "the `cryptography` module is not importable"),
        (audited, "there is no deployment audit for it to read (see the `deployment` step)"),
    ) if not ok), None)
    rows.append(plan_or_run(
        "inventory", ["gb-pull-inventory.py", "--device", label], 600.0,
        _already("inventory", f"*.{label}.json"), f"inventory/*.{label}.json", blocker,
        ("open the Grok Bot desktop app and sign in, then re-run `gb setup --apply`"
         if plat.capability("credential_read").available else
         "run the pull from a signed-in macOS desktop; the inventory artifact it writes is "
         "platform-neutral and can be committed from anywhere")))
    return rows


def cmd_setup(a: SetupArgs) -> int:
    """Zero to measured: preflight, register this desktop, take the first measurements, verify."""
    if a.list_personas or a.persona:
        # Persona walk composes AFTER machine setup (it assumes a measured instance)
        # but runs standalone: gb-setup-persona.py discovers personas/*.json itself.
        argv: List[str] = [sys.executable, str(BIN / "gb-setup-persona.py")]
        if a.list_personas:
            argv.append("--list")
        else:
            argv += ["--persona", str(a.persona)]
        if a.json:
            argv.append("--json")
        return _passthrough(argv, budget_s=120, label="setup persona")
    label, bad = _device_label(a.device)
    if label is None:
        print(f"gb: {bad}", file=sys.stderr)
        return EXIT_USAGE

    before = instance_state()
    plat = platform_support()
    pre_rows = _preflight(plat)
    pre = {r["step"]: r["status"] for r in pre_rows}

    # Fatal, in dry-run as much as under --apply: without the interpreter or the producers there
    # is no plan to print either. ENVIRONMENT, because the machine is what is missing.
    fatal = [r for r in pre_rows if r["step"] in ("python", "cli") and r["status"] != "OK"]
    # The only route out of UNCONFIGURED runs through at least one producer. The surface snapshot
    # needs the network; the deployment audit needs the app. Neither means nothing can be
    # measured, and registering a desktop anyway would flip this root to CONFIGURED with zero
    # measurements behind it — the check wall, restored, with a registry on top.
    measurable = pre.get("network") == "OK" or pre.get("desktop-app") == "OK"

    dev_doc: Optional[Dict[str, Any]] = None
    if fatal:
        dev_row = _step("device", "SKIPPED", "preflight is fatal — nothing was planned",
                        "fix the preflight rows above")
    else:
        dev_row, dev_doc = _plan_device(label)

    refused = bool(a.apply) and not measurable and before.unconfigured and not fatal
    steps: List[Dict[str, Any]] = list(pre_rows)
    actual: List[str] = []

    if fatal:
        steps.append(dev_row)
        steps.append(_step("measure", "SKIPPED", "preflight is fatal", None))
    elif refused:
        steps.append(_step(
            "device", "SKIPPED",
            f"refusing to write {DEVICE_REGISTRY}: nothing can be measured from this machine "
            f"(no network, no desktop app), and registering a desktop is on its own enough to "
            f"make this root look CONFIGURED — that would hand you the 22-check wall with a "
            f"registry on top instead of a measured instance. Nothing was written.",
            "get network access to docs.x.ai, or install the Grok Bot desktop app, then "
            "re-run `gb setup --apply`"))
        steps.append(_step("measure", "SKIPPED", "no producer can run here", None))
    else:
        if a.apply and dev_doc is not None:
            atomic_write_json(ROOT / DEVICE_REGISTRY, dev_doc)
            dev_row = _step("device", "OK", dev_row["detail"].replace("would ", "", 1),
                            device=label, hostname=dev_row.get("hostname"),
                            desktops=dev_row.get("desktops"))
            actual.append(f"wrote {DEVICE_REGISTRY}")
        steps.append(dev_row)
        measured = _measure(label, pre, bool(a.apply), plat)
        steps.extend(measured)
        # Only steps that actually SPAWNED a child go in `actual_actions`. `_run_producer` is
        # the only thing that stamps `exit`; an already-measured row is OK without having run,
        # and reporting its command as an action taken is the lie that would make a second
        # `--apply` look like a re-fetch it deliberately did not perform.
        actual += [str(r.get("command")) for r in measured if "exit" in r]

    after = instance_state()
    # The single sentence that answers "so what do I type now". `--apply` is only the right
    # answer when applying could actually change something: when preflight is fatal, or when
    # the run was REFUSED, the next command is the remediation for that, not a re-run that
    # would take exactly the same decision again.
    blocked = (fatal[0] if fatal else None)
    if blocked is not None:
        nxt = str(blocked.get("remediation") or "gb setup")
    elif refused:
        nxt = "curl -sSI " + DOCS_PROBE_URL
    elif after.unconfigured:
        nxt = "gb setup --apply"
    else:
        nxt = "gb triage"
    # A plan that wrote nothing is not a FAILURE — it is a plan. Only `--apply` that finished
    # with the root still unconfigured has actually failed to do its job.
    verify = _step(
        "verify",
        "OK" if not after.unconfigured else ("FAILED" if a.apply else "PLANNED"),
        f"{after.state} — {after.why}",
        None if not after.unconfigured else
        ("nothing here can run setup — see the ABSENT preflight row(s) above" if fatal else
         "nothing can be measured from this machine, so nothing was written — see the device row"
         if refused else
         "nothing was written, so the root is still UNCONFIGURED — that is what a plan means; "
         "re-run with --apply" if not a.apply else
         "no step produced an artifact; fix the SKIPPED/FAILED rows above and re-run"),
        state=after.state, next_command=nxt)
    steps.append(verify)

    failed = [r for r in steps if r["status"] == "FAILED"]
    if fatal:
        rc = EXIT_ENVIRONMENT
    elif refused:
        rc = EXIT_REFUSED
    elif not a.apply:
        rc = EXIT_OK
    elif after.unconfigured:
        rc = EXIT_ENVIRONMENT
    else:
        rc = EXIT_FINDINGS if failed else EXIT_OK

    payload = envelope(
        "setup",
        dry_run=not a.apply,
        state=after.state,
        device=label,
        hostname=socket.gethostname(),
        state_before=before.state,
        state_after=after.state,
        refused=refused,
        steps=steps,
        # Actions only. `verify` is an OBSERVATION, and listing it beside "would run X" makes
        # the plan look like it intends to do something it merely intends to check.
        planned=[r["detail"] for r in steps
                 if r["status"] == "PLANNED" and r["step"] != "verify"],
        actual_actions=actual,
        next_command=nxt,
        commands=[r["remediation"] for r in steps if r.get("remediation")] or [nxt],
    )

    head = ("gb setup — PLAN (nothing was written; re-run with --apply)" if not a.apply
            else ("gb setup — REFUSED (nothing was written)" if refused
                  else "gb setup — APPLIED"))
    human = [head, ""]
    for row in steps:
        # 16, not 9: NOT_IMPLEMENTED is the longest status a row can carry, and a column that
        # the widest value overflows collides with the next one (`NOT_IMPLEMENTEDkeychain`).
        human.append(f"  {row['status']:<16}{row['step']:<12}{row['detail'][:110]}")
        if row.get("remediation"):
            human.append(f"  {'':<16}{'':<12}fix: {str(row['remediation'])[:110]}")
    human += ["", f"state: {before.state} -> {after.state}", "", "next:",
              f"  {payload['next_command']}"]
    emit(payload, a.json, "\n".join(human))
    return rc


# ---------------------------------------------------------------------------------------------
# `gb platform` — can this tool work on this machine at all, and how much of that is measured
#
# THE PROBLEM IT REMOVES. Measured 2026-09-11, before this verb existed: four files hardcoded
# the macOS support directory, two shelled out to `security`, one drove `launchctl`, and
# `grep -rl 'sys.platform\|platform.system' bin/` returned ZERO. A Windows or Linux operator
# installing the published package therefore got the wave-4 failure again through a new door:
# the macOS path is absent on his machine, every producer reports its input missing, and the
# board prints a wall. One state — "this OS is not verified" — reported as twenty problems.
#
# WHY IT IS CANONICAL. `gb platform` is named by `route_unconfigured`, by `gb setup`'s platform
# row, by the deployment audit's refusal and by the inventory pull's refusal. Deleting it
# leaves four remediations pointing at nothing, which is strictly worse than never having had
# it — the same argument that put `setup` in CANONICAL_VERBS in wave 4.
#
# WHAT IT WILL NOT DO. It will not call Windows or Linux SUPPORTED. Nobody in this repo has run
# either client; the paths are Electron-shaped inferences, and `--selftest` proves the inference
# is implemented consistently, not that it is true. That distinction is the whole verb.
# ---------------------------------------------------------------------------------------------
PLATFORM_FIXTURES = "fixtures/platform"


def _platform_human(plat: Platform) -> List[str]:
    """The rendered block. Shared by the verb and by nothing else yet — kept separate because
    the JSON envelope and this text must not drift into disagreeing about the same fields."""
    lines = [f"{plat.os} · {plat.status}"
             + ("  (FORCED — this is not a measurement of this machine)" if plat.forced else ""),
             "",
             f"  {plat.why}.",
             "",
             f"  support dir   {plat.support_dir or '(none on this platform)'}",
             f"  exists        {'yes' if plat.support_dir_exists else 'no'}",
             f"  path source   {plat.path_source}",
             "",
             "capabilities:"]
    for cap in plat.capabilities:
        lines.append(f"  {cap.status:<16}{cap.name:<20}{cap.detail[:88]}")
        if cap.remediation:
            lines.append(f"  {'':<16}{'':<20}fix: {cap.remediation[:88]}")
    lines += ["", "next:"]
    lines.append(f"  {plat.remediation}" if plat.remediation else
                 "  gb setup            nothing about this platform is in your way")
    return lines


def _platform_case(root: pathlib.Path, spec: Dict[str, Any]) -> Dict[str, Any]:
    """Resolve ONE planted platform and compare it with what the fixture says must happen.

    The environment is rebuilt from scratch rather than layered onto `os.environ`: a fixture
    that inherited this Mac's HOME would resolve half its paths off the machine running the
    test, and would pass here for reasons that do not exist on a runner.
    """
    env: Dict[str, str] = {k: str(root / v) for k, v in (spec.get("env") or {}).items()}
    env.update({k: str(v) for k, v in (spec.get("env_literal") or {}).items()})
    want = spec.get("expect") or {}
    plat = platform_support(sys_platform=spec.get("sys_platform"), env=env)

    bad: List[str] = []

    def cmp(field: str, got: Any, expected: Any) -> None:
        if got != expected:
            bad.append(f"{field}: expected {expected!r}, got {got!r}")

    cmp("os", plat.os, want.get("os"))
    cmp("status", plat.status, want.get("status"))
    cmp("support_dir_exists", plat.support_dir_exists, want.get("support_dir_exists"))
    rel = want.get("support_dir")
    cmp("support_dir", plat.support_dir, None if rel is None else (root / rel))
    # A resolution reached through an override or a forced platform string MUST say so. This is
    # the assertion that stops a fixture transcript from being pasted into a bug report as if it
    # were a reading of someone's machine.
    cmp("forced", plat.forced, True)
    for name, status in (want.get("capabilities") or {}).items():
        cmp(f"capability[{name}]", plat.capability(name).status, status)
    for field, needle in (("why", want.get("why_mentions")),
                          ("path_source", want.get("path_source_mentions")),
                          ("remediation", want.get("remediation_mentions"))):
        if needle and needle not in (getattr(plat, field) or ""):
            bad.append(f"{field} does not mention {needle!r}: {getattr(plat, field)!r}")

    probe = want.get("keychain_probe")
    if probe is not None:
        # The refusal path, driven through the REAL entry point. If this raises, the fixture
        # fails loudly rather than the tool failing quietly on someone's laptop.
        row = _probe_keychain(plat)
        cmp("keychain_probe.status", row["status"], probe.get("status"))
        if probe.get("has_remediation") and not row.get("remediation"):
            bad.append("keychain_probe: refused with no remediation — a dead end")
    return {"case": spec.get("case"), "why": spec.get("why"), "pass": not bad,
            "problems": bad, "resolved": plat.to_json()}


def _platform_selftest(as_json: bool) -> int:
    """Every planted platform under `fixtures/platform/`, resolved and checked.

    THE POINT. Nobody here owns a Windows box or a Linux box, so the Windows and Linux paths
    could only ever be claimed, never demonstrated. Making `platform_support` a pure function of
    (platform string, environment) turns that claim into something a Mac can execute: the
    fixtures plant a foreign home, a foreign `%APPDATA%`, a foreign `$XDG_CONFIG_HOME`, and the
    resolver answers with no knowledge that it is being lied to.

    WHAT IT STILL DOES NOT PROVE. That `%APPDATA%\\Grok Bot` is where the Windows client
    actually writes. That is an Electron inference, it is reported as UNVERIFIED everywhere it
    appears, and only a real Windows install can close it. This selftest proves the inference is
    implemented consistently and refuses honestly — not that it is correct.
    """
    fx = ROOT / PLATFORM_FIXTURES
    specs = sorted(fx.glob("*/expect.json")) if fx.is_dir() else []
    if not specs:
        print(f"gb: {PLATFORM_FIXTURES}/ is absent — an installed copy carries no fixtures.\n"
              f"    run this from a checkout: python3 bin/gb platform --selftest",
              file=sys.stderr)
        return EXIT_ENVIRONMENT
    rows: List[Dict[str, Any]] = []
    for spec_path in specs:
        spec = read_json_capped(spec_path) or {}
        spec["case"] = spec_path.parent.name
        rows.append(_platform_case(spec_path.parent, spec))
    ok = all(r["pass"] for r in rows)
    payload = envelope("platform", selftest=True, cases=rows,
                       passed=sum(1 for r in rows if r["pass"]), total=len(rows), **{"pass": ok})
    human = [f"  [{'PASS' if r['pass'] else 'FAIL'}] {r['case']:<34}{(r['why'] or '')[:80]}"
             + ("" if r["pass"] else "\n         " + "\n         ".join(r["problems"]))
             for r in rows]
    human.append(f"SELFTEST {'PASS' if ok else 'FAIL'} — "
                 f"{sum(1 for r in rows if r['pass'])}/{len(rows)} planted platforms")
    emit(payload, as_json, "\n".join(human))
    return EXIT_OK if ok else EXIT_FINDINGS


def cmd_platform(a: PlatformArgs) -> int:
    """Which OS this is, how well this tool knows it, and what can be done here."""
    if a.selftest:
        return _platform_selftest(a.json)
    plat = platform_support()
    payload = envelope(
        "platform",
        **plat.to_json(),
        overrides={SUPPORT_DIR_ENV: os.environ.get(SUPPORT_DIR_ENV),
                   "GB_PLATFORM": os.environ.get("GB_PLATFORM")},
        next_command=plat.remediation or "gb setup",
        commands=[c.remediation for c in plat.capabilities if c.remediation]
        or [plat.remediation or "gb setup"],
    )
    emit(payload, a.json, "\n".join(_platform_human(plat)))
    # UNSUPPORTED is ENVIRONMENT: the operator asked a fair question and this machine cannot do
    # the job. UNVERIFIED is exit 0 — the tool works, it simply says so with a caveat, and
    # failing a read-only status verb for a caveat would make it unusable in a script.
    return EXIT_ENVIRONMENT if plat.status == "UNSUPPORTED" else EXIT_OK


def cmd_repair(a: RepairArgs) -> int:
    if not a.scope or a.scope not in REPAIRS:
        print(f"gb: repair needs a known --scope. Known: {', '.join(REPAIRS)}\n"
              f"    try: gb repair --scope {sorted(REPAIRS)[0]}", file=sys.stderr)
        return EXIT_USAGE
    argv, why = REPAIRS[a.scope]
    if not a.apply:
        payload = envelope("repair", scope=a.scope, dry_run=True, planned=[why],
                           actual_actions=[], would_run=f"python3 bin/{' '.join(argv)}")
        emit(payload, a.json,
             f"PLANNED  {a.scope}: {why}\n         would run: python3 bin/{' '.join(argv)}\n"
             f"         nothing was written — re-run with --apply")
        return EXIT_OK
    proc = run([sys.executable, str(BIN / argv[0]), *argv[1:]], timeout_s=600, cwd=ROOT)
    ok = proc.code == 0
    payload = envelope("repair", scope=a.scope, dry_run=False, planned=[why],
                       actual_actions=[f"python3 bin/{' '.join(argv)}"],
                       exit=proc.code, detail=(proc.out or proc.err).strip().splitlines()[-1:])
    emit(payload, a.json, f"{'APPLIED ' if ok else 'FAILED  '} {a.scope}: {why}")
    return EXIT_OK if ok else EXIT_FINDINGS


def cmd_validate(a: ValidateArgs) -> int:
    # `platform` re-enters this CLI rather than naming a producer: the planted-platform corpus
    # is resolved by `gb platform --selftest`, which lives here because the refusal path it
    # proves lives here (`_probe_keychain`). A separate producer would have to import the verb
    # to prove it, which is the same coupling with an extra file.
    known = {"plugin": ["gb-plugin-validate.py", "--path", "plugin"],
             "mcp": ["gb-mcp-validate.py"],
             "types": ["gb-typecheck.py", "--dry-run"],
             "platform": ["gb", "platform", "--selftest"],
             "fixtures": ["gb-surface-gate.py", "--selftest"],
             "coverage": ["gb-coverage.py", "--json"],
             "surface": ["gb-surface-snapshot.py", "--json"],
             "archive": ["gb-context-archive.py", "--json"],
             "discovery": ["gb-discover.py", "--json"],
             "gaps": ["gb-gaps.py", "--json"],
             "market": ["gb-market-snapshot.py", "--json"],
             "usecases": ["gb-usecases.py", "--json"],
             "utilization": ["gb-utilization.py", "--json"],
             "whatchanged": ["gb-whatchanged.py", "--json"]}
    if a.thing not in known:
        print(f"gb: cannot validate {a.thing!r}. Known: {', '.join(known)}\n"
              f"    try: gb validate plugin", file=sys.stderr)
        return EXIT_USAGE
    r = probe(a.thing, known[a.thing], timeout_s=300)
    emit(envelope("validate", thing=a.thing, **r), a.json, f"  {r['status']:<12}{r['detail'][:110]}")
    return EXIT_OK if r["status"] == "PASS" else EXIT_FINDINGS


def cmd_audit(a: AuditArgs) -> int:
    proc = run(["git", "log", f"-{max(1, a.limit)}", "--format=%h\t%ad\t%s", "--date=short"],
               timeout_s=60, cwd=ROOT)
    rows = [dict(zip(("sha", "date", "subject"), ln.split("\t", 2)))
            for ln in proc.out.splitlines() if "\t" in ln]
    emit(envelope("audit", mutations=rows), a.json,
         "\n".join(f"  {r['sha']}  {r['date']}  {r['subject'][:90]}" for r in rows))
    return EXIT_OK


def cmd_why(a: WhyArgs) -> int:
    """Provenance for one check: what produced it, what it last said, where that is on disk."""
    gate = run([sys.executable, str(BIN / "gb-surface-gate.py"), "--json"], timeout_s=180, cwd=ROOT)
    hit = None
    if (gate.out or "").strip():
        try:
            for r in json.loads(gate.out).get("checks") or []:
                if r.get("check") == a.id:
                    hit = r
                    break
        except ValueError:
            pass
    if hit is None:
        cov = read_json_capped(ROOT / "coverage-floor.json") or {}
        print(f"gb: no check named {a.id!r}.\n"
              f"    list them: gb triage --json | jq -r '.red[].check'\n"
              f"    coverage floor currently {cov.get('covered')}", file=sys.stderr)
        return EXIT_USAGE
    payload = envelope("why", check=a.id, verdict=hit.get("verdict"), detail=hit.get("detail"),
                       produced_by="bin/gb-surface-gate.py",
                       reads=[str(p.relative_to(ROOT)) for p in
                              (ROOT / "deployment", ROOT / "surface", ROOT / "inventory")
                              if p.exists()])
    emit(payload, a.json,
         f"  {a.id}\n  verdict   {hit.get('verdict')}\n  detail    {hit.get('detail','')[:160]}\n"
         f"  producer  bin/gb-surface-gate.py")
    return EXIT_OK


def cmd_capabilities(a: CapabilitiesArgs) -> int:
    payload = envelope(
        "capabilities",
        contract_version=CONTRACT_VERSION,
        commands={n: (c.__doc__ or "").strip().splitlines()[0] for n, c in COMMANDS.items()},
        exit_codes={str(k): v for k, v in EXIT_CODES.items()},
        subsystems={n: why for n, (_a, why, _s) in SUBSYSTEMS.items()},
        repair_scopes={n: why for n, (_a, why) in REPAIRS.items()},
        help_topics=sorted(TOPICS),
        json_everywhere=True,
        rust_target="asupersync",
    )
    emit(payload, True, "")
    return EXIT_OK


def cmd_robot_docs(_a: BareArgs) -> int:
    print(f"""\
gb — agent handbook (v{VERSION}, contract {CONTRACT_VERSION})

ONE CALL FIRST. `gb triage --json` answers "what is wrong" and hands back the commands that
address it. Do not start by reading bin/; start here.

    gb triage --json | jq '.red[].check'      what is not green
    gb triage --json | jq -r '.commands[]'    what to run next

NOT SET UP YET. On a root where nothing has ever been measured, `triage`, `health`, `work` and
`doctor` do NOT emit one ERROR per unmeasured check. They emit one route and exit 3:

    gb triage --json | jq -r '.state'         CONFIGURED | UNCONFIGURED
    gb triage --json | jq -r '.next_command'  `gb setup --apply`

Branch on `.state` BEFORE `.verdict`: on an unconfigured root `verdict` is null on purpose, and
`state: "UNCONFIGURED"` never collapses into an empty result set.

WHICH MACHINE IS THIS. Before you conclude the deployment is broken, check whether this tool is
even verified here. `gb platform --json | jq -r .status` is SUPPORTED (macOS — measured),
UNVERIFIED (Windows/Linux — the vendor ships a desktop client, the support-directory path is an
Electron-shaped INFERENCE nobody here has confirmed, and the credential read and scheduler
install are NOT_IMPLEMENTED) or UNSUPPORTED (iOS/Android — companion apps to a cloud computer,
with no local state to read). On an unconfigured root the route block carries `.platform` and
points at `gb platform` FIRST when the status is not SUPPORTED, because "run gb setup" is the
wrong answer to "nobody has verified your operating system".

    gb platform --json | jq -r '.capabilities[] | "\\(.status) \\(.capability)"'
    GB_SUPPORT_DIR=<path>   move the support-directory path (never the status)
    GB_PLATFORM=<string>    force the platform; answers carry `forced: true`

CONTRACT. `gb capabilities --json` is the machine-readable version of this page: command list,
exit-code dictionary, subsystem list, repair scopes. Read it instead of remembering this.

EXIT CODES. Branch on them; they are a dictionary, not a mood.
{TOPICS['exit-codes']}

STDOUT IS DATA. Every command takes `--json` and prints the envelope on stdout and nothing else;
diagnostics are on stderr. `gb <verb> --json | jq` never needs a grep.

MUTATION. Only `gb repair` and `gb setup` write, and only with `--apply`. Without it you get the
plan and `actual_actions: []`. There is no other mutating verb. `gb setup --apply` is idempotent
and refuses (exit 5) rather than leaving this root half-configured.

CANCELLATION. Every command is safe to SIGINT: artifact writes are atomic, so you get either the
old artifact or the new one, and the process exits 130.
""")
    return EXIT_OK


def cmd_quickstart(_a: BareArgs) -> int:
    print(f"""\
gb — quickstart

This repo watches one thing: a live Grok Bot deployment (the account, its Bots, its plugins, and
the vendor surface those depend on). The producers in bin/ measure it; `gb` is how you ask.

  0. gb setup             fresh clone? this registers this machine and takes the first
                          measurements (dry run unless --apply). Until something has been
                          measured, every other verb routes here and exits 3.
  1. gb triage            what is wrong right now, and what to run about it
  2. gb doctor            is the measuring apparatus itself healthy (6 subsystems)
  3. gb why <check>       why one check says what it says
  4. gb repair --scope X  rebuild a derived artifact (dry run unless --apply)

The weekly tick (`bin/gb-weekly.sh`) is the only thing that fetches from the vendor on a
schedule. Everything `gb` does is read-only against artifacts already on disk, except
`repair --apply` and `setup --apply`.

Run `gb examples` for worked invocations, `gb help <topic>` for a manual page, and
`gb capabilities --json` if you are a program.
""")
    return EXIT_OK


def cmd_examples(_a: BareArgs) -> int:
    print(EXAMPLES.rstrip())
    return EXIT_OK


def cmd_info(_a: BareArgs) -> int:
    sha = run(["git", "rev-parse", "--short", "HEAD"], timeout_s=30, cwd=ROOT).out.strip()
    payload = envelope(
        "info", contract_version=CONTRACT_VERSION, repo=str(ROOT), runtime_sha=sha,
        python=sys.version.split()[0],
        producers=sorted(p.name for p in BIN.glob("gb-*.py")),
        artifact_roots=sorted(d.name for d in ROOT.iterdir()
                              if d.is_dir() and not d.name.startswith(".")),
    )
    emit(payload, True, "")
    return EXIT_OK


def cmd_help(a: HelpArgs) -> int:
    if not a.topic:
        print("topics: " + ", ".join(sorted(TOPICS)) + "\n\n  gb help exit-codes")
        return EXIT_OK
    if a.topic not in TOPICS:
        print(f"gb: no topic {a.topic!r}. Known: {', '.join(sorted(TOPICS))}\n"
              f"    try: gb help exit-codes", file=sys.stderr)
        return EXIT_USAGE
    print(f"{a.topic}\n\n{TOPICS[a.topic]}")
    return EXIT_OK


def cmd_completion(a: CompletionArgs) -> int:
    verbs = " ".join(COMMANDS)
    if a.shell == "bash":
        print(f'_gb() {{ COMPREPLY=($(compgen -W "{verbs}" -- "${{COMP_WORDS[1]}}")); }}\n'
              f'complete -F _gb gb')
    else:
        print(f"#compdef gb\n_arguments '1:command:({verbs})'")
    return EXIT_OK


def cmd_monitor(a: MonitorArgs) -> int:
    """Pass through to `bin/gb-monitor.py`, relaying its contract unchanged.

    The producer owns the thresholds and their justification; this verb only makes them
    reachable. Its exit codes are returned verbatim rather than remapped, including the one
    that matters most: ANY unmeasured threshold exits 3, dominating a BREACH's 1. That ordering
    is the board's own severity lattice — "I could not measure it" outranks "I measured it and
    it is bad", because a threshold you cannot read is not a threshold you passed.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-monitor.py")]
    if a.watch:
        argv += ["--watch", "--interval", str(a.interval)]
    if a.budget_pct is not None:
        argv += ["--budget-pct", str(a.budget_pct)]
    if a.max_age_days is not None:
        argv += ["--max-age-days", str(a.max_age_days)]
    if a.dry_run:
        argv.append("--dry-run")
    if a.json:
        argv.append("--json")
    # --watch has no finite budget by construction; everything else is one gate child (~0.3s).
    proc = run(argv, timeout_s=86400 if a.watch else 300, cwd=ROOT)
    if proc.out:
        print(proc.out, end="" if proc.out.endswith("\n") else "\n")
    if proc.err:
        print(proc.err, end="" if proc.err.endswith("\n") else "\n", file=sys.stderr)
    return int(proc.code)


def cmd_mine(a: MineArgs) -> int:
    """Pass through to `bin/gb-mine.py`.

    Deliberately thin: mining reads two large corpora (the franken-harvest ledger and a
    222-repo mirror through ripwire) and takes tens of seconds. Reimplementing any of that
    here would put a slow, network-and-disk-heavy read inside the dispatcher every other verb
    shares. The producer stays independently runnable; this verb only makes it discoverable.

    The child's stdout is relayed verbatim so `gb mine --json | jq` behaves exactly as
    `gb-mine.py --json | jq` does, and its exit code is returned unchanged so the contract is
    the producer's, not a translation of it.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-mine.py")]
    for q in a.query:
        argv += ["--query", q]
    argv += ["--limit", str(a.limit)]
    if a.mirror:
        argv += ["--mirror", a.mirror]
    if a.dry_run:
        argv.append("--dry-run")
    if a.json:
        argv.append("--json")
    proc = run(argv, timeout_s=900, cwd=ROOT)
    if proc.timed_out:
        print("gb: mining exceeded its 900s budget — narrow it with `--query` or `--mirror`",
              file=sys.stderr)
        return EXIT_ENVIRONMENT
    if proc.out:
        print(proc.out, end="" if proc.out.endswith("\n") else "\n")
    if proc.err:
        print(proc.err, end="" if proc.err.endswith("\n") else "\n", file=sys.stderr)
    return int(proc.code)

def _passthrough(argv: List[str], *, budget_s: int, label: str) -> int:
    """Relay a producer verbatim: its stdout, its stderr, its exit code.

    The dispatcher must not translate a producer's contract. `gb templates validate` has to
    exit 1 on a bad template exactly as `gb-templates.py validate` does, or the verb is a
    different tool wearing the same name.

    ONE EXCEPTION, added 2026-09-12: a producer that is not on disk. Measured in a public
    clone, NINE verbs reached this line with a missing script and CPython answered for us —
    `can't open file '.../bin/gb-bot.py'`, exit 2. That is wrong twice. The exit code says
    USAGE, blaming the operator's command line, when this tool's own published table reserves
    3 for ENVIRONMENT, "missing producer or toolchain". And the message names a path the
    reader did not choose and cannot fix.

    Relaying a contract is right; relaying CPython's argv handling is not a contract, it is
    the absence of one. `gb export` is the permanent case: the publisher cannot ship itself,
    because its own leak-scanner patterns contain the client identifiers they hunt, so a
    clone will always lack it and should say so plainly.
    """
    script = pathlib.Path(argv[1]) if len(argv) > 1 else None
    if script is not None and script.suffix in (".py", ".sh") and not script.exists():
        print(
            f"gb {label}: this build does not ship {script.name} — the verb is registered but "
            f"its producer is absent, so it cannot run here. Run it from a full checkout.",
            file=sys.stderr,
        )
        return EXIT_ENVIRONMENT
    proc = run(argv, timeout_s=budget_s, cwd=ROOT)
    if proc.timed_out:
        print(f"gb: {label} exceeded its {budget_s}s budget", file=sys.stderr)
        return EXIT_ENVIRONMENT
    if proc.out:
        print(proc.out, end="" if proc.out.endswith("\n") else "\n")
    if proc.err:
        print(proc.err, end="" if proc.err.endswith("\n") else "\n", file=sys.stderr)
    return int(proc.code)


def cmd_templates(a: TemplatesArgs) -> int:
    """Pass through to `bin/gb-templates.py` — the proposed Bot templates and their rules.

    `deploy` was registered in the producer and NOT here, so `gb templates deploy` answered
    `invalid choice` while every commit message and every hand-off cited it as the one-touch
    path. Measured 2026-09-11 by the dogfood audit — a verb documented but never once invoked
    through the CLI it was documented against. That is the exact failure the dogfooding rule
    exists to catch, and it caught its author.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-templates.py"), a.action]
    if a.action in ("show", "deploy", "publish"):
        if not a.id:
            print(
                f"gb: `templates {a.action}` needs an id — try `gb templates list`",
                file=sys.stderr,
            )
            return EXIT_USAGE
        argv.append(a.id)
    if a.apply:
        if a.action not in ("deploy", "publish"):
            print("gb: --apply only means something for `templates deploy|publish`", file=sys.stderr)
            return EXIT_USAGE
        argv.append("--apply")
    if a.action == "publish" and a.apply:
        if not a.screened:
            print("gb: `templates publish --apply` needs --screened (human reviewed the charter)",
                  file=sys.stderr)
            return EXIT_USAGE
        argv.append("--screened")
    if a.action == "publish":
        if a.source:
            argv += ["--source", a.source]
        if a.force:
            argv.append("--force")
    if a.path:
        argv += ["--path", a.path]
    if a.json:
        argv.append("--json")
    # deploy/publish talk to the live account; give them the producer's own budget.
    return _passthrough(argv, budget_s=600 if a.action in ("deploy", "publish") else 120, label="templates")


def cmd_walk(a: WalkArgs) -> int:
    """Pass through to `bin/gb-walk.py` — the guided tour of the CLI and the Bot templates."""
    argv: List[str] = [sys.executable, str(BIN / "gb-walk.py")]
    if a.paste:
        argv += ["bots", "--paste", a.paste]
    else:
        argv.append(a.track)
        if a.step:
            argv.append("--step")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="walk")


def cmd_daily(a: DailyArgs) -> int:
    """Pass through to `bin/gb-daily.sh` — the daily tick.

    Weekly was the wrong clock. Measured 2026-09-11: the whole docs.x.ai surface carries ONE
    lastmod and rebuilds inside the week, GitHub showed 270 repos pushed in a day, and the X
    firehose is hourly. A weekly poll against a daily surface reports yesterday's world.
    """
    argv: List[str] = [str(BIN / "gb-daily.sh")]
    if a.no_fetch:
        argv.append("--no-fetch")
    for k in a.kind:
        argv += ["--kind", k]
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=3600, label="the daily tick")


def cmd_digest(a: DigestArgs) -> int:
    """Pass through to `bin/gb-digest.py` — the only human-readable surface in the repo.

    Its exit code carries a verdict: 1 means BROKE (a source is stale, or a diff is UNMEASURED),
    which must never be softened into "nothing changed".
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-digest.py")]
    if a.json:
        argv.append("--json-out")
    return _passthrough(argv, budget_s=600, label="digest")


def cmd_mirror(a: MirrorArgs) -> int:
    """Pass through to `bin/gb-mirror.py` — the only verb that works on a STRANGER's machine.

    Tier A needs no token, no network and no repo artifact: it reads the desktop client's own
    state off disk. `--deep` adds the read-only RPC reads for routines, memory and usage.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-mirror.py")]
    if a.deep:
        argv.append("--deep")
    # `--save --since latest` is valid and ordered: the producer diffs against the PREVIOUS
    # reading, then saves, so a before/after in one command compares the right pair.
    if a.save:
        argv.append("--save")
    if a.since:
        argv += ["--since", a.since]
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="mirror")


