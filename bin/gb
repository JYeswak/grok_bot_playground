EXAMPLES = """\
  gb platform                    what this OS can do here, and how much of that is measured
  gb platform --json | jq -r .status   SUPPORTED | UNVERIFIED | UNSUPPORTED
  gb platform --selftest         resolve every planted platform under fixtures/platform/
  gb setup                       what configuring this machine would do (writes nothing)
  gb setup --apply               register this desktop and take the first measurements
  gb setup --apply --device brain    name the machine yourself instead of using the hostname
  gb triage                      what is wrong right now, and the command that fixes it
  gb triage --json | jq .red     the same answer, for a script
  gb work                        what to pick up next, and whether the ranking is trustworthy
  gb work --source beads --limit 5       one substrate, five rows
  gb work --json | jq -r '.sources[].status'   OK / EMPTY / UNREACHABLE, never conflated
  gb doctor --scope gate         one subsystem, not all six
  gb health --json               one line of state, cheap enough for a loop
  gb repair --scope fixtures     show what regenerating would do (dry run)
  gb repair --scope fixtures --apply     actually do it
  gb capabilities --json         the machine-readable contract for this tool
  gb why g8-desktop-inventory    what that check reads, and where it looked
  gb validate plugin             is the plugin submittable, without submitting it
"""


# ---------------------------------------------------------------------------------------------
# Typed argument surface — one frozen dataclass per verb (clap `#[derive(Args)]`)
# ---------------------------------------------------------------------------------------------
@dataclasses.dataclass(frozen=True)
class TriageArgs:
    """What is wrong right now, and the exact command that addresses it."""

    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class WorkArgs:
    """What to pick up next here, and whether that ranking can be trusted."""

    limit: int = arg(default=10, help="how many ranked items to show")
    source: Optional[str] = arg(help="beads | issues; omit for both")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class DoctorArgs:
    """Diagnose every subsystem (or one), report PASS/FAIL per subsystem."""

    scope: Optional[str] = arg(help="one subsystem; omit for all (see `gb help subsystems`)")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class HealthArgs:
    """Single-shot state of the deployment — lighter than doctor, safe in a loop."""

    json: bool = arg(help="machine-readable envelope on stdout")
    watch: bool = arg(help="re-run until interrupted")
    interval: int = arg(default=60, help="seconds between --watch runs")


@dataclasses.dataclass(frozen=True)
class SetupArgs:
    """Take this machine from a fresh clone to a measured instance. Dry-run unless --apply."""

    apply: bool = arg(help="actually register and measure; without this the command only plans")
    device: Optional[str] = arg(help="label for THIS machine in desktops.json (default: hostname)")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class RepairArgs:
    """Idempotently rebuild a derived artifact. Dry-run unless --apply is given."""

    scope: Optional[str] = arg(help="what to rebuild (see `gb help repair`)")
    apply: bool = arg(help="actually write; without this the command only plans")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class ValidateArgs:
    """Verify a thing without changing it. Pure read."""

    thing: str = arg(positional=True, help="plugin | mcp | types | platform | fixtures")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class AuditArgs:
    """Recent mutations to this repo's artifacts, with provenance."""

    limit: int = arg(default=15, help="how many to show")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class WhyArgs:
    """Provenance for one check or facet: what it reads, and what it last said."""

    id: str = arg(positional=True, help="a check id (g8-desktop-inventory) or facet name")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class CapabilitiesArgs:
    """The machine-readable contract: version, commands, exit codes, subsystems."""

    json: bool = arg(help="machine-readable envelope on stdout (the default shape)")


@dataclasses.dataclass(frozen=True)
class HelpArgs:
    """Topic-based manual. `gb help` lists the topics."""

    topic: Optional[str] = arg(positional=True, help="exit-codes | subsystems | repair | tick | porting")


@dataclasses.dataclass(frozen=True)
class CompletionArgs:
    """Print a shell completion script."""

    shell: str = arg(positional=True, choices=("bash", "zsh"), help="bash | zsh")


@dataclasses.dataclass(frozen=True)
class BareArgs:
    """No arguments."""


@dataclasses.dataclass(frozen=True)
class PlatformArgs:
    """Which OS this is, whether this tool is verified on it, and what works here."""

    json: bool = arg(help="machine-readable envelope on stdout")
    selftest: bool = arg(help="resolve every planted platform under fixtures/platform/ instead")



@dataclasses.dataclass(frozen=True)
class MineArgs:
    """Mine franken-harvest and the local mirror for capability this deployment could adopt."""

    query: Tuple[str, ...] = arg(help="what to mine for; repeatable (default: this repo's gaps)")
    limit: int = arg(default=10, help="maximum candidates to emit")
    mirror: Optional[str] = arg(help="Dicklesworthstone mirror root")
    dry_run: bool = arg(help="mine and report, but write no artifact")
    json: bool = arg(help="machine-readable envelope on stdout")


COMMANDS: Dict[str, type] = {
