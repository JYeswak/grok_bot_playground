def cmd_export(a: ExportArgs) -> int:
    """Pass through to `bin/gb-export-public.py` — split the publishable tool out.

    REFUSES an unset directory rather than stringifying it. `a.out` is Optional, and with no
    DIR the old line passed the literal "None" through, producing
    "…/grokbot/None overlaps the repo" — an error that blames the repo layout for a missing
    argument. An argument that reaches the producer as the string "None" is one nobody
    validated, and the message it produces sends the reader to the wrong file.
    """
    if not a.out:
        print(
            "gb export: needs a target directory — `gb export /tmp/gb-public`. It must be "
            "OUTSIDE this repo; the exporter refuses to overlap its own tree.",
            file=sys.stderr,
        )
        return EXIT_USAGE
    argv: List[str] = [sys.executable, str(BIN / "gb-export-public.py"), "--out", a.out]
    if a.force:
        argv.append("--force")
    if a.no_git:
        argv.append("--no-git")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="export")

def cmd_gates(a: GatesArgs) -> int:
