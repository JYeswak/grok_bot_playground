def cmd_group(a: GroupArgs) -> int:
    """Pass through to `bin/gb-group.py` — rooms, dry run unless --yes (no delete RPC)."""
    argv: List[str] = [sys.executable, str(BIN / "gb-group.py")]
    if a.json:
        argv.append("--json")
    argv.append(a.action)
    if a.action == "create":
        if a.text:
            argv += ["--description", a.text]
        if a.members:
            argv += ["--members", a.members]
        if a.yes:
            argv.append("--yes")
        # create takes name positionally in the producer
        if a.target:
            argv.append(a.target)
    elif a.action in ("members", "send"):
        if not a.target:
            print(f"gb: group {a.action} needs a room", file=sys.stderr)
            return EXIT_USAGE
        argv.append(a.target)
        if a.action == "members":
            if not a.set:
                print("gb: group members needs --set (full-set replace)", file=sys.stderr)
                return EXIT_USAGE
            argv += ["--set", a.set]
        else:
            if not a.text:
                print("gb: group send needs message text", file=sys.stderr)
                return EXIT_USAGE
            argv.append(a.text)
            if a.mention:
                argv += ["--mention", a.mention]
        if a.yes:
            argv.append("--yes")
    return _passthrough(argv, budget_s=300, label="group")

def cmd_dm(a: DmArgs) -> int:
    """Pass through to `bin/gb-group.py dm` — Bot-to-Bot nudge wire."""
    if not (a.from_bot and a.to_bot and a.text):
        print("gb: dm needs <from> <to> '<text>'", file=sys.stderr)
        return EXIT_USAGE
    argv: List[str] = [sys.executable, str(BIN / "gb-group.py"), "dm",
                       a.from_bot, a.to_bot, a.text]
    if a.yes:
        argv.append("--yes")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="dm")






HANDLERS: Dict[str, Callable[[Any], int]] = {
    "setup": cmd_setup, "platform": cmd_platform, "mine": cmd_mine, "monitor": cmd_monitor,
    "templates": cmd_templates, "walk": cmd_walk, "daily": cmd_daily, "digest": cmd_digest,
    "mirror": cmd_mirror, "demand": cmd_demand, "galaxy": cmd_galaxy, "fleet": cmd_fleet,
    "blast": cmd_blast,
    "corpus": cmd_corpus, "dogfood": cmd_dogfood, "gatesdoc": cmd_gatesdoc,
    "readme": cmd_readme,
    "advise": cmd_advise,
    "x": cmd_x,
    "post": cmd_post, "findings": cmd_findings, "teach": cmd_teach,
    "roadmap": cmd_roadmap,
    "triage": cmd_triage, "work": cmd_work, "doctor": cmd_doctor, "health": cmd_health,
    "repair": cmd_repair, "mcp": cmd_mcp, "bot": cmd_bot,
    "group": cmd_group, "dm": cmd_dm,
    "handover": cmd_handover, "record": cmd_record, "matrix": cmd_matrix,
    "export": cmd_export, "gates": cmd_gates, "bench": cmd_bench,
    "links": cmd_links, "sources": cmd_sources, "store": cmd_store,
    "skill-coverage": cmd_skill_coverage,
    "inventory": cmd_inventory, "spend": cmd_spend, "goldens": cmd_goldens,
    "deployment": cmd_deployment, "feeds": cmd_feeds, "github": cmd_github,
    "validate": cmd_validate, "audit": cmd_audit, "why": cmd_why,
    "capabilities": cmd_capabilities, "robot-docs": cmd_robot_docs, "quickstart": cmd_quickstart,
    "examples": cmd_examples, "info": cmd_info, "help": cmd_help, "completion": cmd_completion,
}

def body() -> int:
    # `--version` is handled BEFORE parse_sub, because the subcommand parser treats a bare
    # flag as an unknown argument: `gb --version` answered "unrecognized arguments" until
    # 2026-09-12. A tool that cannot say what it is cannot be caught being out of date, and
    # that is exactly how a published mirror sat at 18 of 57 verbs with nobody noticing.
    if any(a in ("--version", "-V") for a in sys.argv[1:]):
        print(f"gb {VERSION} build {build_stamp()} ({len(COMMANDS)} verbs)")
        print(
            "  the build stamp is DERIVED from the producers on disk, not declared — two "
            "exports of different trees cannot agree on it"
        )
        return EXIT_OK
    name, args = parse_sub(
        COMMANDS,
        prog="gb",
        description=(
            "gb — operate a live Grok Bot deployment: measure the vendor surface and your own "
            "account, judge both, and act on what is wrong."
        ),
        # `gb mirror` FIRST, corrected 2026-09-12. This said "start with: gb triage" everywhere,
        # and on a fresh clone triage REFUSES (exit 3) and routes onward to a write
        # (`gb setup --apply`). `gb mirror` answers read-only in 0.24s with ranked findings
        # about the reader's own Bots, needs no token and no network, and was recommended by
        # nothing. Measured in a clean export: three steps to a refusal versus one to an answer.
        epilog=(
            "start with:   gb mirror        (read-only, no token, no network — your own fleet)\n"
            "then:         gb triage        (needs gb setup first)\n"
            "agent?        gb robot-docs\n"
            "machine?      gb capabilities --json"
        ),
    )
    return HANDLERS[name](args)


if __name__ == "__main__":
    main(body)
