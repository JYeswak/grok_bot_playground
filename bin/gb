# subsystem -> (producer argv, what it answers). The single registry every verb reads, so a new
# producer is discoverable from `doctor`, `health`, `capabilities` and `repair` by adding it here
# once rather than in four places.
# subsystem -> (argv, what it answers, which line of its output IS the summary). The third
# field is explicit because producers disagree: most end with their verdict, but `gb-coverage`
# leads with the headline and then prints the ledger, and `gb-mcp-validate` ends inside a table.
# Guessing which line matters produced rows that showed a table cell next to the word PASS.
SUBSYSTEMS: Dict[str, Tuple[List[str], str, str]] = {
    "gate": (["gb-surface-gate.py"], "the 24-check board over the live deployment", "last"),
    "coverage": (["gb-coverage.py"], "which facets are measured vs unread", "first"),
    "types": (["gb-typecheck.py", "--dry-run"], "the strict-typing floor under two checkers", "last"),
    "mcp": (["gb-mcp-validate.py"], "every MCP server a Bot can reach", "first"),
    "plugin": (["gb-plugin-validate.py", "--path", "plugin"], "the publishable plugin manifest", "last"),
    "spine": (["gbtypes-selftest.py"], "the typed spine's own cancel-correctness proofs", "last"),
}

REPAIRS: Dict[str, Tuple[List[str], str]] = {
    "fixtures": (["gb-make-fixtures.py"], "regenerate the gate's fixture corpus from source"),
    "coverage": (["gb-coverage.py"], "rewrite COVERAGE.md from the artifacts on disk"),
    "types": (["gb-typecheck.py"], "re-measure the type floor and write the artifact"),
    "surface": (["gb-surface-snapshot.py"], "re-fetch the vendor surface and write surface/<stamp>"),
    "market": (["gb-market-snapshot.py"], "re-take the market snapshot and write market/<stamp>.json"),
}

# ---------------------------------------------------------------------------------------------
# `gb work` — the two work-tracking substrates this repo actually keeps, and the constants that
# say how to read them. Measured 2026-09-11.
# ---------------------------------------------------------------------------------------------
BEADS_TOOL = "br"
# `br` mutates on read unless told not to: `list` auto-exports the JSONL and auto-imports it
# back. `gb work` is a pure read, so both are off — otherwise asking "what should I do next"
# dirties the git worktree, and the operator's next `git status` blames him for it.
BR_READONLY: Tuple[str, ...] = ("--no-auto-flush", "--no-auto-import")

# The issue tracker is NOT this repo. Measured: `git remote -v` here is empty, so `gh issue
# list` without `--repo` dies with "no git remotes found" — the public tool's issues live on
# this slug. Hardcoding it is the fix for an inference that cannot work, not a shortcut.
ISSUES_REPO = "JYeswak/grok_bot_playground"
ISSUE_FIELDS = "number,title,state,labels,updatedAt"

# Untouched for two weekly ticks. `bin/gb-weekly.sh` runs once a week and g3 already allows an
# 8-day snapshot gap, so one missed tick is normal and two is the first number that means
# nobody looked. Named here so the threshold is arguable instead of magic.
STALE_DAYS = 14.0

# GitHub issues carry labels, not priorities. br carries a real 0..4 priority, so beads need no
# table; issues do. This map is a DECLARED CONVENTION, not a measurement — as of 2026-09-11 the
# public repo has zero issues, so there is nothing to fit it to. Unmatched labels rank neutral
# rather than being guessed at.
ISSUE_LABEL_PRIORITY: Dict[str, int] = {
    "security": 0, "critical": 0, "p0": 0,
    "bug": 1, "regression": 1, "p1": 1,
    "enhancement": 3, "documentation": 3, "docs": 3,
    "question": 4, "wontfix": 4, "backlog": 4,
}
NOT_READY_LABELS = frozenset({"blocked", "on-hold", "waiting", "needs-info"})
NEUTRAL_PRIORITY = 2

TOPICS: Dict[str, str] = {
    "exit-codes": "\n".join(f"  {c:<4}{why}" for c, why in sorted(EXIT_CODES.items())),
    "subsystems": "\n".join(f"  {n:<10}{why}" for n, (_a, why, _s) in SUBSYSTEMS.items()),
    "repair": "\n".join(f"  {n:<10}{why}" for n, (_a, why) in REPAIRS.items())
    + "\n\n  Every repair is dry-run by default. --apply is required to write.",
    "platform": (
        "  `gb platform` answers the question that comes BEFORE `gb setup`: can this tool do\n"
        "  anything at all on this operating system, and how much of that answer is measured?\n\n"
        "    SUPPORTED     macOS. Measured: every path and capability is read off a live\n"
        "                  install, and this is the platform the weekly tick runs on.\n"
        "    UNVERIFIED    Windows and Linux. The vendor ships a desktop client for both\n"
        "                  (docs.x.ai/grok-bot/faq), the client is Electron, and its userData\n"
        "                  directory is %APPDATA%\\\\Grok Bot / $XDG_CONFIG_HOME/Grok Bot by that\n"
        "                  framework's own rule. Nobody in this repo has ever run either one,\n"
        "                  so the path is an INFERENCE and is labelled as one. The credential\n"
        "                  read and the scheduler install are NOT_IMPLEMENTED there, and say\n"
        "                  so instead of failing inside a subprocess.\n"
        "    UNSUPPORTED   iOS and Android. Those are COMPANION apps to a cloud computer, not\n"
        "                  desktop clients: there is no local session and no support directory\n"
        "                  here to read, so this tool refuses rather than inventing an absence.\n\n"
        "  TWO OVERRIDES.\n"
        "    GB_SUPPORT_DIR=<path>   operator surface. Point the tool at the real userData\n"
        "                            directory when the inferred one is wrong. It moves the\n"
        "                            PATH and never the STATUS — pointing at a directory does\n"
        "                            not verify an operating system.\n"
        "    GB_PLATFORM=<string>    test surface. Force the platform string so a foreign\n"
        "                            codepath can be exercised here. Every answer produced\n"
        "                            under it carries `forced: true`.\n\n"
        "  `gb platform --selftest` resolves every planted platform under fixtures/platform/.\n"
        "  It proves the Windows and Linux branches are implemented and refuse honestly. It\n"
        "  does NOT prove the inferred paths are correct; only a real install can do that."
    ),
    "tick": (
        "  The weekly tick is `bin/gb-weekly.sh`: snapshot the vendor surface, audit this\n"
        "  account, judge both, and record one product change. `gb triage` is the read-only\n"
        "  version you run any time — it never fetches and never writes."
    ),
    "setup": (
        "  A fresh clone has measured nothing, so gb triage routes to gb setup instead of\n"
        "  printing one ERROR per unmeasured check. Setup runs one journaled transaction:\n\n"
        "    preflight    prove the interpreter, producers, app, keychain, crypto and network\n"
        "    stage        preserve the exact prior registry and journal the proposed digest\n"
        "    measure      run eligible first producers while desktops.json remains unchanged\n"
        "    commit       publish the staged registry only after a new dated artifact exists\n"
        "    verify       require artifact-backed CONFIGURED; restore on every failure\n\n"
        "  Dry-run is the default and performs zero writes. It prints the exact registry digest\n"
        "  delta and producer prerequisites. --apply writes an fsynced journal under state/,\n"
        "  restores registry bytes plus transaction-created artifacts after failure or cancel,\n"
        "  and records recovery argv. gb setup --selftest runs the same implementation\n"
        "  against offline fake producers and known-bad timeout/interruption fixtures.\n\n"
        "  What it cannot do for you: install or sign into the Grok Bot desktop app. That is a\n"
        "  human step, and the first authenticated read also needs you to click Allow on a\n"
        "  macOS keychain prompt."
    ),
    "porting": (
        "  This CLI is shaped for Asupersync, not Tokio. The subcommand tree is\n"
        "  #[derive(Subcommand)]; each verb becomes async fn(cx: &Cx) -> Outcome<_, _>; the\n"
        "  deadline is region-scoped via with_deadline, not a per-call timeout; artifact writes\n"
        "  are fs::write_atomic. See bin/gbtypes.py's header for the file:line mapping table."
    ),
}

EXAMPLES = """\
  gb platform                    what this OS can do here, and how much of that is measured
  gb platform --json | jq -r .status   SUPPORTED | UNVERIFIED | UNSUPPORTED
  gb platform --selftest         resolve every planted platform under fixtures/platform/
  gb setup                       what configuring this machine would do (writes nothing)
  gb setup --apply               measure first, then commit this desktop transactionally
  gb setup --apply --device brain    name the machine yourself instead of using the hostname
  gb setup --selftest            offline fake-producer rollback and commit proofs
  gb market bots                 live pull (botdirectory ∪ shares), then list
  gb market bots --offline       stamps only
  gb market jobs                 one Thompson draw per job (impression only; not a WINNER)
  gb market jobs --offline       valid catalog cache only; missing bandit store is explore
  gb market keep <share_id>      record_outcome success=true for that subject's arm
  gb market skip <share_id>      record_outcome success=false
  gb market ban  <share_id>      mark the arm ineligible (hard filter, not a beta bump)
  gb market deploy <share_id> [...]  one-click cards: name, job, charter, grokbot:// install URL
  gb market pack founder         persona shortlist of Thompson draws (not swarm)
  gb market refresh --corpus     official snapshot + public corpus + shares
  gb market bots                 official ∪ corpus ∪ URL finds; denominators printed
  gb stack founder               desk: skills + plugin install URLs + methods
  gb triage                      what is wrong right now, and the command that fixes it
  gb triage --json | jq .red     the same answer, for a script
  gb work                        what to pick up next, and whether the ranking is trustworthy
  gb work --source beads --limit 5       one substrate, five rows
  gb work --json | jq -r '.sources[].status'   OK / EMPTY / UNREACHABLE, never conflated
  gb doctor --scope gate         one subsystem, not all six
  gb health --json               one line of state, cheap enough for a loop
  gb repair --scope fixtures     show what regenerating would do (dry run)
  gb repair --scope fixtures --apply     actually do it
  gb capabilities --json         the machine-readable contract for this tool
  gb why g8-desktop-inventory    what that check reads, and where it looked
  gb validate plugin             is the plugin submittable, without submitting it
"""


# ---------------------------------------------------------------------------------------------
# Typed argument surface — one frozen dataclass per verb (clap `#[derive(Args)]`)
# ---------------------------------------------------------------------------------------------
@dataclasses.dataclass(frozen=True)
class TriageArgs:
    """What is wrong right now, and the exact command that addresses it."""

    # No choices= here on purpose: gb-triage-check.py owns the id list and its
    # usage_error teaches (live CHECK_ORDER + try line, exit 2). An argparse
    # wall would duplicate that list and rot beside it.
    check: Optional[str] = arg(
        default=None,
        help="one check id (e.g. g8-desktop-inventory); omit for the whole board",
        positional=True,
    )
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class WorkArgs:
    """What to pick up next here, and whether that ranking can be trusted."""

    limit: int = arg(default=10, help="how many ranked items to show")
    source: Optional[str] = arg(help="beads | issues; omit for both")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class DoctorArgs:
    """Diagnose every subsystem (or one), report PASS/FAIL per subsystem."""

    scope: Optional[str] = arg(help="one subsystem; omit for all (see `gb help subsystems`)")
    json: bool = arg(help="machine-readable envelope on stdout")
    quiet: bool = arg(help="print nothing when every subsystem is PASS; print only failing rows otherwise")


@dataclasses.dataclass(frozen=True)
class HealthArgs:
    """Single-shot state of the deployment — lighter than doctor, safe in a loop."""

    json: bool = arg(help="machine-readable envelope on stdout")
    watch: bool = arg(help="re-run until interrupted")
    interval: int = arg(default=60, help="seconds between --watch runs")


@dataclasses.dataclass(frozen=True)
class SetupArgs:
    """Take this machine from a fresh clone to a measured instance. Dry-run unless --apply."""

    apply: bool = arg(help="actually register and measure; without this the command only plans")
    device: Optional[str] = arg(help="label for THIS machine in desktops.json (default: hostname)")
    persona: Optional[str] = arg(
        help="compatibility alias for a role/persona id; delegates to gb role",
        aliases=("--personas",),
    )
    list_personas: bool = arg(help="compatibility alias for gb role --list")
    selftest: bool = arg(help="offline transactional setup proofs with fake producers")
    json: bool = arg(help="machine-readable envelope on stdout")

@dataclasses.dataclass(frozen=True)
class RoleArgs:
    """Turn one role phrase into a resumable, receipted Bot journey. first hour is refused."""

    role: Optional[str] = arg(
        positional=True,
        help='supported role phrase, e.g. "founder operator"',
    )
    apply: bool = arg(help="apply the frozen plan named by --plan-hash")
    plan_hash: Optional[str] = arg(help="exact hash emitted by the no-write plan")
    status: Optional[str] = arg(help="inspect ATTEMPT_ID without mutation")
    resume: Optional[str] = arg(help="resume ATTEMPT_ID after one human checkpoint")
    checkpoint: Optional[str] = arg(help="exact checkpoint id returned by the attempt")
    rollback: Optional[str] = arg(help="compensate ATTEMPT_ID and report residue")
    list: bool = arg(help="list supported role phrases and persona versions")
    input: Optional[str] = arg(help="first-job input artifact after human attachment")
    attempt_id: Optional[str] = arg(help="first-job attempt id")
    selftest: bool = arg(help="offline journey state-machine proof")
    capabilities: bool = arg(help="machine-readable role backend contract")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class RepairArgs:
    """Idempotently rebuild a derived artifact. Dry-run unless --apply is given."""

    scope: Optional[str] = arg(help="what to rebuild (see `gb help repair`)")
    apply: bool = arg(help="actually write; without this the command only plans")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class ValidateArgs:
    """Verify a thing without changing it. Pure read."""

    thing: str = arg(positional=True, help="plugin | mcp | types | platform | fixtures | coverage | surface | archive | discovery | gaps | market | usecases | utilization | whatchanged")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class AuditArgs:
    """Recent mutations to this repo's artifacts, with provenance."""

    limit: int = arg(default=15, help="how many to show")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class WhyArgs:
    """Provenance for one check or facet: what it reads, and what it last said."""

    id: str = arg(positional=True, help="a check id (g8-desktop-inventory) or facet name")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class CapabilitiesArgs:
    """The machine-readable contract: version, commands, exit codes, subsystems."""

    json: bool = arg(help="machine-readable envelope on stdout (the default shape)")


@dataclasses.dataclass(frozen=True)
class HelpArgs:
    """Topic-based manual. `gb help` lists the topics."""

    topic: Optional[str] = arg(positional=True, help="exit-codes | subsystems | repair | tick | porting")


@dataclasses.dataclass(frozen=True)
class CompletionArgs:
    """Print a shell completion script."""

    shell: str = arg(positional=True, choices=("bash", "zsh"), help="bash | zsh")


@dataclasses.dataclass(frozen=True)
class BareArgs:
    """No arguments."""



@dataclasses.dataclass(frozen=True)
class RobotDocsArgs:
    """Agent handbook for the army path and operator surfaces."""

    topic: Optional[str] = arg(
        positional=True,
        help="guide (default: print the handbook)",
    )


@dataclasses.dataclass(frozen=True)
class PlatformArgs:
    """Which OS this is, whether this tool is verified on it, and what works here."""

    json: bool = arg(help="machine-readable envelope on stdout")
    selftest: bool = arg(help="resolve every planted platform under fixtures/platform/ instead")



@dataclasses.dataclass(frozen=True)
class MonitorArgs:
    """Named thresholds over the artifacts already on disk, for a scheduler to branch on."""

    once: bool = arg(help="a single pass (the default)")
    watch: bool = arg(help="loop until interrupted; refused with --json")
    interval: int = arg(default=300, help="seconds between --watch passes")
    budget_pct: Optional[float] = arg(help="spend ceiling as a percent of the allowance")
    max_age_days: Optional[int] = arg(help="artifact staleness ceiling in days")
    json: bool = arg(help="machine-readable envelope on stdout")
    dry_run: bool = arg(help="evaluate and report, but write no artifact")


@dataclasses.dataclass(frozen=True)
class MineArgs:
    """Mine franken-harvest and the local mirror for capability this deployment could adopt."""

    query: Tuple[str, ...] = arg(help="what to mine for; repeatable (default: this repo's gaps)")
    limit: int = arg(default=10, help="maximum candidates to emit")
    mirror: Optional[str] = arg(help="Dicklesworthstone mirror root")
    dry_run: bool = arg(help="mine and report, but write no artifact")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class TemplatesArgs:
    """The Bot templates this repo proposes, and the rules that keep them runnable."""

    action: str = arg(
        default="list",
        help="list | show | validate | stats | deploy | publish",
        choices=("list", "show", "validate", "stats", "deploy", "publish"),
        positional=True,
    )
    id: Optional[str] = arg(help="template id, for `show`, `deploy` and `publish`", positional=True)
    role: Optional[str] = arg(help="delegate a human role phrase to gb role (first hour is refused)")
    apply: bool = arg(help="deploy/publish: act for real (dry run without it)")
    screened: bool = arg(help="publish: a human reviewed the charter for private data")
    force: bool = arg(help="publish: allow minting drafts under an owned template (refused by default)")
    source: Optional[str] = arg(help="publish: source Bot name or uuid (default: Grok)")
    path: Optional[str] = arg(help="templates directory (default: templates/)")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class WalkArgs:
    """Guided tour of the CLI or the Bot templates this repo proposes."""

    track: Optional[str] = arg(
        default=None,
        help="cli | bots",
        choices=("cli", "bots"),
        positional=True,
    )
    paste: Optional[str] = arg(
        help="print ONLY that template's charter, ready to paste"
    )
    role: Optional[str] = arg(
        help="delegate a human role phrase to gb role (first hour is refused)"
    )
    galaxy: Optional[str] = arg(
        help="walk one livestream seat from galaxy-seats.json (founder, engineer, ...)"
    )
    step: bool = arg(help="page through one item at a time")
    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class BootstrapArgs:
    """Compatibility on-ramp: army verbs, or a named role that is still active."""

    role: Optional[str] = arg(help="human role phrase (omit for the army path)")
    json: bool = arg(help="machine-readable envelope on stdout")
    for_agent: bool = arg(
        help="print the four-command first hour for an agent: market bots, deploy, pack, stack"
    )

@dataclasses.dataclass(frozen=True)
class DigestArgs:
    """What changed, in prose, with an executable action on every row."""

    json: bool = arg(help="machine-readable envelope on stdout")


@dataclasses.dataclass(frozen=True)
class MirrorArgs:
    """Read YOUR Grok Bot deployment off this machine and rank it against the corpus."""

    deep: bool = arg(help="also read routines, memory and usage from the API (read-only)")
    save: bool = arg(
        help="record this reading in mirror/<ISO>.json so a later run can diff it"
    )
