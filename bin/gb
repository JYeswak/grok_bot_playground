def cmd_fleet(a: FleetArgs) -> int:
    """Pass through to `bin/gb-fleet.py` — the live account surface.

    This verb exists because its absence was measured: the same three RPCs were hand-rolled as
    inline scripts six times in one evening, and each copy got something wrong — the numeric id
    where the automations read demands a UUID, a roster read off the per-machine cache that
    reported a live Bot as deleted, and an `updatedAtMs` that arrives as a str on one path.
    """
    if a.action in ("rebuild", "rollback"):
        # --plan is the default (producer plans when --apply is absent); --apply is explicit
        # only. Rollback deletes exactly manifest["created"] by new_numeric_id, nothing else.
        # Annotated HERE, at the first binding, because the fall-through path below used to
        # carry the annotation and a later-added branch turned that into a redefinition.
        argv: List[str] = [sys.executable, str(BIN / "gb-rebuild-fleet.py")]
        if a.action == "rollback":
            if not a.manifest:
                print("gb: fleet rollback needs a manifest path", file=sys.stderr)
                return EXIT_USAGE
            return _passthrough(argv + ["--rollback", a.manifest], budget_s=600, label="fleet rollback")
        if a.only:
            argv += ["--only", a.only]
        if a.spec:
            argv += ["--spec", a.spec]
        if a.apply:
            argv.append("--apply")
        return _passthrough(argv, budget_s=600, label="fleet rebuild")
    argv = [sys.executable, str(BIN / "gb-fleet.py"), a.action]
    if a.bot:
        argv += ["--bot", a.bot]
    if a.text:
        argv += ["--text", a.text]
    if a.yes:
        argv.append("--yes")
    if a.json:
        argv.append("--json-out")
    return _passthrough(argv, budget_s=600, label="fleet")


def cmd_corpus(a: CorpusArgs) -> int:
    """Pass through to `bin/gb-corpus.py` — corpus figures, single-sourced.

    Exists because the same statistics were recomputed by throwaway python every time anyone
    asked, by different agents, with different denominators — which is how two correct answers
    (625 over the 487 rows with text, 557 including the 158 zeros) looked like a disagreement.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-corpus.py"), a.action]
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="corpus")


def cmd_dogfood(a: DogfoodArgs) -> int:
    """Pass through to `bin/gb-dogfood.py` — capability `gb` cannot reach.

    Ratchets: the gap baseline may shrink freely and may only grow with a recorded acceptance.
    It found two live breaks on its first run, both of which had shipped.
