def cmd_inventory(a: InventoryArgs) -> int:
    """Pass through to `bin/gb-inventory.py` — account surface reads — or pull a fresh
    per-device inventory via `bin/gb-pull-inventory.py` (dry run unless --apply writes)."""
    if a.read == "pull":
        if not a.device:
            print("gb: inventory pull needs --device <label from desktops.json>", file=sys.stderr)
            return EXIT_USAGE
        argv: List[str] = [sys.executable, str(BIN / "gb-pull-inventory.py"),
                           "--device", a.device]
        if not a.apply:
            argv.append("--dry-run")
        if a.json:
            argv.append("--json")
        return _passthrough(argv, budget_s=600, label="inventory pull")
    argv = [sys.executable, str(BIN / "gb-inventory.py"), a.read]
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="inventory")

