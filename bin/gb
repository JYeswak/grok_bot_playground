#!/usr/bin/env python3
"""gb — the one entry point for operating a Grok Bot deployment.

WHY THIS EXISTS (measured 2026-09-11). There were 22 producers in `bin/` and no CLI. Every one
of them answered `--help` cleanly, so each SCRIPT was fine; what did not exist was a TOOL. An
agent had to already know that the thing that reads the account is `gb-pull-inventory.py`, that
the thing that judges it is `gb-surface-gate.py`, and that neither is discoverable from the
other. Nothing answered "what is wrong right now", because nothing was allowed to speak for the
whole system. 22 scripts is not a CLI; it is a directory.

`gb` is deliberately THIN. It does not reimplement a single producer — it dispatches to them
through `gbtypes.run` (bounded capture, enforced deadline, four-valued classification) and
composes their JSON. A producer stays independently runnable; `gb` is the surface that makes the
family legible without reading `bin/`.

EXIT CODES (the dictionary; `gb help exit-codes` prints it, `gb capabilities --json` ships it):

    0   OK           the command did what it says, findings are clean
    1   FINDINGS     it ran correctly and the answer is bad (doctor FAIL, health RED)
    2   USAGE        the invocation was wrong — bad flag, unknown command, no command
    3   ENVIRONMENT  this machine cannot run the check (missing producer, missing toolchain)
    4   UPSTREAM     the vendor or network failed; nothing here is broken
    5   REFUSED      a mutation was requested without the explicit gate that permits it
    130 CANCELLED    SIGINT arrived; no partial artifact was written

1 is not 3 and neither is 4: "your deployment is red", "this laptop cannot measure it", and
"x.ai is down" are three different days, and an agent that cannot tell them apart retries the
wrong one. The severity lattice behind it is `gbtypes.Severity` (Ok < Err < Cancelled <
Panicked), transliterated from Asupersync's `types::outcome`.

RUST TARGET: ASUPERSYNC. The subcommand tree is `#[derive(Subcommand)]` over an enum whose
variants carry their own args struct — that is exactly what `gbargs.parse_sub` builds, so the
port is a match, not a rewrite. Each subcommand body becomes `async fn(cx: &Cx) -> Outcome<_, _>`
with the deadline supplied by the enclosing region (`with_deadline`) rather than by a per-call
timeout, and the fan-out in `doctor` becomes `Cx::race_drained`/`Scope` children instead of a
sequential loop.
"""
from __future__ import annotations

import dataclasses
import datetime as dt
import importlib.util
import json
import hashlib
import os
import pathlib
import re
import shutil
import shlex
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from typing import Any, Callable, Dict, List, Optional, Sequence, Set, Tuple

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from gbargs import arg, parse_sub  # noqa: E402
from gblib import (  # noqa: E402
    SUPPORT_DIR_ENV,
    Platform,
    platform_support,
    unavailable,
)
from gbtypes import (  # noqa: E402
    Cancelled,
    FileSnapshot,
    Severity,
    atomic_write_bytes,
    atomic_write_json,
    durable_remove,
    durable_transition,
    main,
    read_json_capped,
    run,
)

ROOT = pathlib.Path(__file__).resolve().parents[1]
BIN = ROOT / "bin"
VERSION = "1.0.0"
CONTRACT_VERSION = 1


def build_stamp() -> str:
    """A content hash of the producers this build actually carries.

    WHY A HAND-EDITED VERSION IS NOT ENOUGH (measured 2026-09-12). The published mirror was a
    STALE EXPORT: 18 registered verbs against 57 here, a `bin/gb` of 1997 lines against 3233.
    Nothing could tell the two apart. `version` is a hand-edited constant in three files and
    the exporter only checks the three for AGREEMENT, never for CHANGE, so a months-old export
    and today's export produce identical metadata and `pip install -U` sees no upgrade.

    And there was no `--version` flag at all: `gb --version` answered "unrecognized
    arguments". A tool that cannot say what it is cannot be caught being out of date, which is
    why the staleness survived long enough for someone to install 18 of 57 verbs and see no
    warning.

    So the stamp is DERIVED, never declared: the verb count plus a hash over the names and
    sizes of every producer on disk. Two exports of different trees cannot agree on it, and
    nobody has to remember to bump anything. Names and sizes rather than contents because this
    runs on every `--version` and must stay cheap; it detects a producer added, removed, or
    changed in length, which is the staleness class that actually occurred.
    """
    h = hashlib.sha256()
    try:
        rows = sorted(
            (p.name, p.stat().st_size)
            for p in BIN.iterdir()
            if p.is_file() and (p.suffix in (".py", ".sh") or p.name == "gb")
        )
    except OSError:
        return "unknown"
    for name, size in rows:
        h.update(f"{name}:{size}\n".encode())
    return f"{len(rows)}p.{h.hexdigest()[:12]}"

EXIT_OK, EXIT_FINDINGS, EXIT_USAGE = 0, 1, 2
EXIT_ENVIRONMENT, EXIT_UPSTREAM, EXIT_REFUSED = 3, 4, 5

EXIT_CODES: Dict[int, str] = {
    0: "OK — ran, and the findings are clean",
    1: "FINDINGS — ran correctly, and the answer is bad (doctor FAIL / health RED)",
    2: "USAGE — bad flag, unknown command, or no command",
    3: "ENVIRONMENT — this machine cannot run the check (missing producer or toolchain)",
    4: "UPSTREAM — the vendor or network failed; nothing local is broken",
    5: "REFUSED — a mutation was requested without the gate that permits it",
    130: "CANCELLED — SIGINT arrived; no partial artifact was written",
}

