#!/usr/bin/env python3
"""gb — the one entry point for operating a Grok Bot deployment.

WHY THIS EXISTS (measured 2026-09-11). There were 22 producers in `bin/` and no CLI. Every one
of them answered `--help` cleanly, so each SCRIPT was fine; what did not exist was a TOOL. An
agent had to already know that the thing that reads the account is `gb-pull-inventory.py`, that
the thing that judges it is `gb-surface-gate.py`, and that neither is discoverable from the
other. Nothing answered "what is wrong right now", because nothing was allowed to speak for the
whole system. 22 scripts is not a CLI; it is a directory.

`gb` is deliberately THIN. It does not reimplement a single producer — it dispatches to them
through `gbtypes.run` (bounded capture, enforced deadline, four-valued classification) and
composes their JSON. A producer stays independently runnable; `gb` is the surface that makes the
family legible without reading `bin/`.

EXIT CODES (the dictionary; `gb help exit-codes` prints it, `gb capabilities --json` ships it):

    0   OK           the command did what it says, findings are clean
    1   FINDINGS     it ran correctly and the answer is bad (doctor FAIL, health RED)
    2   USAGE        the invocation was wrong — bad flag, unknown command, no command
    3   ENVIRONMENT  this machine cannot run the check (missing producer, missing toolchain)
    4   UPSTREAM     the vendor or network failed; nothing here is broken
    5   REFUSED      a mutation was requested without the explicit gate that permits it
    130 CANCELLED    SIGINT arrived; no partial artifact was written

1 is not 3 and neither is 4: "your deployment is red", "this laptop cannot measure it", and
"x.ai is down" are three different days, and an agent that cannot tell them apart retries the
wrong one. The severity lattice behind it is `gbtypes.Severity` (Ok < Err < Cancelled <
Panicked), transliterated from Asupersync's `types::outcome`.

RUST TARGET: ASUPERSYNC. The subcommand tree is `#[derive(Subcommand)]` over an enum whose
variants carry their own args struct — that is exactly what `gbargs.parse_sub` builds, so the
port is a match, not a rewrite. Each subcommand body becomes `async fn(cx: &Cx) -> Outcome<_, _>`
with the deadline supplied by the enclosing region (`with_deadline`) rather than by a per-call
timeout, and the fan-out in `doctor` becomes `Cx::race_drained`/`Scope` children instead of a
sequential loop.
"""
from __future__ import annotations

import dataclasses
import datetime as dt
import importlib.util
import json
import hashlib
import os
import pathlib
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from typing import Any, Callable, Dict, List, Optional, Sequence, Set, Tuple

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from gbargs import arg, parse_sub  # noqa: E402
from gblib import (  # noqa: E402
    SUPPORT_DIR_ENV,
    Platform,
    platform_support,
    unavailable,
)
from gbtypes import Severity, atomic_write_json, main, read_json_capped, run  # noqa: E402

ROOT = pathlib.Path(__file__).resolve().parents[1]
BIN = ROOT / "bin"
VERSION = "1.0.0"
CONTRACT_VERSION = 1


def build_stamp() -> str:
    """A content hash of the producers this build actually carries.

    WHY A HAND-EDITED VERSION IS NOT ENOUGH (measured 2026-09-12). The published mirror was a
    STALE EXPORT: 18 registered verbs against 57 here, a `bin/gb` of 1997 lines against 3233.
    Nothing could tell the two apart. `version` is a hand-edited constant in three files and
    the exporter only checks the three for AGREEMENT, never for CHANGE, so a months-old export
    and today's export produce identical metadata and `pip install -U` sees no upgrade.

    And there was no `--version` flag at all: `gb --version` answered "unrecognized
    arguments". A tool that cannot say what it is cannot be caught being out of date, which is
    why the staleness survived long enough for someone to install 18 of 57 verbs and see no
    warning.

    So the stamp is DERIVED, never declared: the verb count plus a hash over the names and
    sizes of every producer on disk. Two exports of different trees cannot agree on it, and
    nobody has to remember to bump anything. Names and sizes rather than contents because this
    runs on every `--version` and must stay cheap; it detects a producer added, removed, or
    changed in length, which is the staleness class that actually occurred.
    """
    h = hashlib.sha256()
    try:
        rows = sorted(
            (p.name, p.stat().st_size)
            for p in BIN.iterdir()
            if p.is_file() and (p.suffix in (".py", ".sh") or p.name == "gb")
        )
    except OSError:
        return "unknown"
    for name, size in rows:
        h.update(f"{name}:{size}\n".encode())
    return f"{len(rows)}p.{h.hexdigest()[:12]}"

EXIT_OK, EXIT_FINDINGS, EXIT_USAGE = 0, 1, 2
EXIT_ENVIRONMENT, EXIT_UPSTREAM, EXIT_REFUSED = 3, 4, 5

EXIT_CODES: Dict[int, str] = {
    0: "OK — ran, and the findings are clean",
    1: "FINDINGS — ran correctly, and the answer is bad (doctor FAIL / health RED)",
    2: "USAGE — bad flag, unknown command, or no command",
    3: "ENVIRONMENT — this machine cannot run the check (missing producer or toolchain)",
    4: "UPSTREAM — the vendor or network failed; nothing local is broken",
    5: "REFUSED — a mutation was requested without the gate that permits it",
    130: "CANCELLED — SIGINT arrived; no partial artifact was written",
}

# subsystem -> (producer argv, what it answers). The single registry every verb reads, so a new
# producer is discoverable from `doctor`, `health`, `capabilities` and `repair` by adding it here
# once rather than in four places.
# subsystem -> (argv, what it answers, which line of its output IS the summary). The third
# field is explicit because producers disagree: most end with their verdict, but `gb-coverage`
# leads with the headline and then prints the ledger, and `gb-mcp-validate` ends inside a table.
# Guessing which line matters produced rows that showed a table cell next to the word PASS.
SUBSYSTEMS: Dict[str, Tuple[List[str], str, str]] = {
    "gate": (["gb-surface-gate.py"], "the 24-check board over the live deployment", "last"),
    "coverage": (["gb-coverage.py"], "which facets are measured vs unread", "first"),
    "types": (["gb-typecheck.py", "--dry-run"], "the strict-typing floor under two checkers", "last"),
    "mcp": (["gb-mcp-validate.py"], "every MCP server a Bot can reach", "first"),
    "plugin": (["gb-plugin-validate.py", "--path", "plugin"], "the publishable plugin manifest", "last"),
    "spine": (["gbtypes-selftest.py"], "the typed spine's own cancel-correctness proofs", "last"),
}

REPAIRS: Dict[str, Tuple[List[str], str]] = {
    "fixtures": (["gb-make-fixtures.py"], "regenerate the gate's fixture corpus from source"),
    "coverage": (["gb-coverage.py"], "rewrite COVERAGE.md from the artifacts on disk"),
    "types": (["gb-typecheck.py"], "re-measure the type floor and write the artifact"),
    "surface": (["gb-surface-snapshot.py"], "re-fetch the vendor surface and write surface/<stamp>"),
    "market": (["gb-market-snapshot.py"], "re-take the market snapshot and write market/<stamp>.json"),
}

# ---------------------------------------------------------------------------------------------
# `gb work` — the two work-tracking substrates this repo actually keeps, and the constants that
# say how to read them. Measured 2026-09-11.
# ---------------------------------------------------------------------------------------------
BEADS_TOOL = "br"
# `br` mutates on read unless told not to: `list` auto-exports the JSONL and auto-imports it
# back. `gb work` is a pure read, so both are off — otherwise asking "what should I do next"
# dirties the git worktree, and the operator's next `git status` blames him for it.
BR_READONLY: Tuple[str, ...] = ("--no-auto-flush", "--no-auto-import")

# The issue tracker is NOT this repo. Measured: `git remote -v` here is empty, so `gh issue
# list` without `--repo` dies with "no git remotes found" — the public tool's issues live on
# this slug. Hardcoding it is the fix for an inference that cannot work, not a shortcut.
ISSUES_REPO = "JYeswak/grok_bot_playground"
ISSUE_FIELDS = "number,title,state,labels,updatedAt"

# Untouched for two weekly ticks. `bin/gb-weekly.sh` runs once a week and g3 already allows an
# 8-day snapshot gap, so one missed tick is normal and two is the first number that means
# nobody looked. Named here so the threshold is arguable instead of magic.
STALE_DAYS = 14.0

# GitHub issues carry labels, not priorities. br carries a real 0..4 priority, so beads need no
# table; issues do. This map is a DECLARED CONVENTION, not a measurement — as of 2026-09-11 the
# public repo has zero issues, so there is nothing to fit it to. Unmatched labels rank neutral
# rather than being guessed at.
ISSUE_LABEL_PRIORITY: Dict[str, int] = {
    "security": 0, "critical": 0, "p0": 0,
    "bug": 1, "regression": 1, "p1": 1,
    "enhancement": 3, "documentation": 3, "docs": 3,
    "question": 4, "wontfix": 4, "backlog": 4,
}
NOT_READY_LABELS = frozenset({"blocked", "on-hold", "waiting", "needs-info"})
NEUTRAL_PRIORITY = 2

TOPICS: Dict[str, str] = {
    "exit-codes": "\n".join(f"  {c:<4}{why}" for c, why in sorted(EXIT_CODES.items())),
    "subsystems": "\n".join(f"  {n:<10}{why}" for n, (_a, why, _s) in SUBSYSTEMS.items()),
    "repair": "\n".join(f"  {n:<10}{why}" for n, (_a, why) in REPAIRS.items())
    + "\n\n  Every repair is dry-run by default. --apply is required to write.",
    "platform": (
        "  `gb platform` answers the question that comes BEFORE `gb setup`: can this tool do\n"
        "  anything at all on this operating system, and how much of that answer is measured?\n\n"
        "    SUPPORTED     macOS. Measured: every path and capability is read off a live\n"
        "                  install, and this is the platform the weekly tick runs on.\n"
        "    UNVERIFIED    Windows and Linux. The vendor ships a desktop client for both\n"
        "                  (docs.x.ai/grok-bot/faq), the client is Electron, and its userData\n"
        "                  directory is %APPDATA%\\\\Grok Bot / $XDG_CONFIG_HOME/Grok Bot by that\n"
        "                  framework's own rule. Nobody in this repo has ever run either one,\n"
        "                  so the path is an INFERENCE and is labelled as one. The credential\n"
        "                  read and the scheduler install are NOT_IMPLEMENTED there, and say\n"
        "                  so instead of failing inside a subprocess.\n"
        "    UNSUPPORTED   iOS and Android. Those are COMPANION apps to a cloud computer, not\n"
        "                  desktop clients: there is no local session and no support directory\n"
        "                  here to read, so this tool refuses rather than inventing an absence.\n\n"
        "  TWO OVERRIDES.\n"
        "    GB_SUPPORT_DIR=<path>   operator surface. Point the tool at the real userData\n"
        "                            directory when the inferred one is wrong. It moves the\n"
        "                            PATH and never the STATUS — pointing at a directory does\n"
        "                            not verify an operating system.\n"
        "    GB_PLATFORM=<string>    test surface. Force the platform string so a foreign\n"
        "                            codepath can be exercised here. Every answer produced\n"
        "                            under it carries `forced: true`.\n\n"
        "  `gb platform --selftest` resolves every planted platform under fixtures/platform/.\n"
        "  It proves the Windows and Linux branches are implemented and refuse honestly. It\n"
        "  does NOT prove the inferred paths are correct; only a real install can do that."
    ),
    "tick": (
        "  The weekly tick is `bin/gb-weekly.sh`: snapshot the vendor surface, audit this\n"
        "  account, judge both, and record one product change. `gb triage` is the read-only\n"
        "  version you run any time — it never fetches and never writes."
    ),
    "setup": (
        "  A fresh clone has measured nothing, so `gb triage` routes to `gb setup` instead of\n"
        "  printing one ERROR per unmeasured check. Setup runs four steps:\n\n"
        "    preflight    python, this CLI's producers, the Grok Bot desktop app's support dir,\n"
        "                 whether the client's keychain item EXISTS (presence only — no value is\n"
        "                 read or printed), `cryptography`, and reachability of docs.x.ai\n"
        "    device       register THIS machine in desktops.json, keyed on hostname so a\n"
        "                 re-run cannot duplicate the row\n"
        "    measure      the producers that need no prior state: the vendor surface snapshot\n"
        "                 and the local deployment audit, then the account inventory pull\n"
        "    verify       re-classify the root, and say whether it is CONFIGURED now\n\n"
        "  Dry-run by default (`actual_actions: []`). `--apply` writes. If nothing can be\n"
        "  measured here at all, `--apply` REFUSES (exit 5) rather than registering a desktop\n"
        "  and leaving a root that only LOOKS configured.\n\n"
        "  What it cannot do for you: install or sign into the Grok Bot desktop app. That is a\n"
