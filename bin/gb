def cmd_group(a: GroupArgs) -> int:
    """Pass through to `bin/gb-group.py` — rooms, dry run unless --yes (no delete RPC)."""
    argv: List[str] = [sys.executable, str(BIN / "gb-group.py")]
    if a.json:
        argv.append("--json")
    argv.append(a.action)
    if a.action == "create":
        if a.text:
            argv += ["--description", a.text]
        if a.members:
            argv += ["--members", a.members]
        if a.yes:
            argv.append("--yes")
        # create takes name positionally in the producer
        if a.target:
            argv.append(a.target)
    elif a.action in ("members", "send"):
        if not a.target:
            print(f"gb: group {a.action} needs a room", file=sys.stderr)
            return EXIT_USAGE
        argv.append(a.target)
        if a.action == "members":
            if not a.set:
                print("gb: group members needs --set (full-set replace)", file=sys.stderr)
                return EXIT_USAGE
            argv += ["--set", a.set]
        else:
            if not a.text:
                print("gb: group send needs message text", file=sys.stderr)
                return EXIT_USAGE
            argv.append(a.text)
            if a.mention:
                argv += ["--mention", a.mention]
        if a.yes:
            argv.append("--yes")
    return _passthrough(argv, budget_s=300, label="group")

def cmd_dm(a: DmArgs) -> int:
    """Pass through to `bin/gb-group.py dm` — Bot-to-Bot nudge wire."""
    if not (a.from_bot and a.to_bot and a.text):
        print("gb: dm needs <from> <to> '<text>'", file=sys.stderr)
        return EXIT_USAGE
    argv: List[str] = [sys.executable, str(BIN / "gb-group.py"), "dm",
                       a.from_bot, a.to_bot, a.text]
    if a.yes:
        argv.append("--yes")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="dm")






HANDLERS: Dict[str, Callable[[Any], int]] = {
    "setup": cmd_setup, "role": cmd_role, "bootstrap": cmd_bootstrap, "platform": cmd_platform, "mine": cmd_mine, "monitor": cmd_monitor,
    "templates": cmd_templates, "walk": cmd_walk, "daily": cmd_daily, "digest": cmd_digest,
    "mirror": cmd_mirror, "demand": cmd_demand, "plugins": cmd_plugins,
    "market": cmd_market, "swarm": cmd_swarm, "stack": cmd_stack,
    "jobs": cmd_jobs, "galaxy": cmd_galaxy, "fleet": cmd_fleet,
    "blast": cmd_blast,
    "corpus": cmd_corpus, "dogfood": cmd_dogfood, "gatesdoc": cmd_gatesdoc,
    "readme": cmd_readme,
    "advise": cmd_advise,
    "research": cmd_research,
    "schema": cmd_schema,
    "bot-conformance": cmd_bot_conformance,
    "template-conformance": cmd_template_conformance,
    "skill-conformance": cmd_skill_conformance,
    "plugin-conformance": cmd_plugin_conformance,
    "compliance": cmd_compliance,
    "x": cmd_x,
    "post": cmd_post, "findings": cmd_findings, "teach": cmd_teach,
    "roadmap": cmd_roadmap,
    "triage": cmd_triage, "work": cmd_work, "doctor": cmd_doctor, "health": cmd_health,
    "repair": cmd_repair, "mcp": cmd_mcp, "bot": cmd_bot,
    "group": cmd_group, "dm": cmd_dm,
    "handover": cmd_handover, "record": cmd_record, "matrix": cmd_matrix,
    "export": cmd_export, "gates": cmd_gates, "bench": cmd_bench,
    "links": cmd_links, "sources": cmd_sources, "store": cmd_store,
    "skills": cmd_skills,
    "skill-coverage": cmd_skill_coverage,
    "inventory": cmd_inventory, "spend": cmd_spend,
    "deployment": cmd_deployment, "feeds": cmd_feeds, "grokbotdev": cmd_grokbotdev, "github": cmd_github,
    "validate": cmd_validate, "audit": cmd_audit, "why": cmd_why,
    "capabilities": cmd_capabilities, "robot-docs": cmd_robot_docs, "quickstart": cmd_quickstart,
    "examples": cmd_examples, "info": cmd_info, "help": cmd_help, "completion": cmd_completion,
}


DIFF_GUESSES = frozenset({"diff", "changed", "whatchanged", "what-changed", "whats-new", "whatsnew"})


def _is_diff_guess(token: str) -> bool:
    """True when the unknown verb is an agent's name for the day-diff."""
    folded = token.lower().replace("_", "-")
    return folded in DIFF_GUESSES or folded.replace("-", "") in {
        g.replace("-", "") for g in DIFF_GUESSES
    }


def _hint_diff(token: str) -> int:
    """Unknown-command error that names the exact day-diff argv. Stderr = diag."""
    print(
        f"gb: no command {token!r}.\n"
        f"    day diff:  gb daily --no-fetch --json",
        file=sys.stderr,
    )
    return EXIT_USAGE

def _is_army_guess(token: str) -> bool:
    """True when the unknown verb is a newbie's name for the army on-ramp."""
    folded = token.lower().replace("_", "-")
    compact = folded.replace("-", "")
    return folded in ARMY_GUESSES or compact in {
        g.replace("-", "") for g in ARMY_GUESSES
    }


def _hint_army(token: str, as_json: bool) -> int:
    """Bounded newbie redirect into templates, skills, and plugins."""
    if as_json:
        emit(envelope(
            "army-redirect",
            status="USAGE",
            error=f"no command {token!r}",
            mutates=False,
            next=ARMY_NEXT,
            recovery_argv=["gb", "market", "bots"],
            list_argv=["gb", "market", "bots"],
        ), True, "")
    else:
        print(
            f"gb: no command {token!r}.\n"
            f"    army:  {ARMY_NEXT}",
            file=sys.stderr,
        )
    return EXIT_USAGE


def body() -> int:
    # `--version` is handled BEFORE parse_sub, because the subcommand parser treats a bare
    # flag as an unknown argument: `gb --version` answered "unrecognized arguments" until
    # 2026-09-12. A tool that cannot say what it is cannot be caught being out of date, and
    # that is exactly how a published mirror sat at 18 of 57 verbs with nobody noticing.
    if any(a in ("--version", "-V") for a in sys.argv[1:]):
        print(f"gb {VERSION} build {build_stamp()} ({len(COMMANDS)} verbs)")
        print(
            "  the build stamp is DERIVED from the producers on disk, not declared — two "
            "exports of different trees cannot agree on it"
        )
        return EXIT_OK
    # BARE `gb` ROUTES INSTEAD OF PRINTING THE 58-VERB WALL (measured 2026-09-12). A
    # first-run operator typed `gb`, got a 6.3 KB usage dump on stderr and exit 2, and
    # learned nothing — the turn never started. The zeroth verb now answers the same
    # question `gb triage` answers on a configured root, and the same route `gb setup`
    # offers on a fresh one. `-h`/`--help` still print the full manual; any other flag
    # falls through to the parser so a typo keeps its usage error.
    rest = [a for a in sys.argv[1:] if a not in ("--version", "-V")]
    pos = [a for a in rest if not a.startswith("-")]
    # Intent-legible newbie verbs (start/launch/hello/onboard/init) must not fall through
    # to Levenshtein (`start`→`store`, `hello`→`help`, `init`→`info`) or the 58-verb wall.
    if pos and pos[0] not in COMMANDS and _is_army_guess(pos[0]):
        return _hint_army(pos[0], "--json" in rest)
    # Day-diff guesses (diff/changed/whatchanged) name the exact argv, same contract.
    if pos and pos[0] not in COMMANDS and _is_diff_guess(pos[0]):
        return _hint_diff(pos[0])
    if not pos and not any(a in ("-h", "--help") for a in rest):
        if any(a != "--json" for a in rest):
            name, args = parse_sub(
                COMMANDS,
                prog="gb",
                description="gb — operate a live Grok Bot deployment.",
            )
            return HANDLERS[name](args)
        reason = f"gb: next: {ARMY_NEXT}"
        payload = envelope(
            "gb",
            status="OK",
            mutates=False,
            next=ARMY_NEXT,
            commands=list(ARMY_COMMANDS),
        )
        emit(payload, "--json" in rest, reason)
        return EXIT_OK
    name, args = parse_sub(
        COMMANDS,
        prog="gb",
        description=(
            "gb — set up, run and grow a Grok Bot deployment from one command."
        ),
        epilog=(
            "ARMY / AGENT:\n"
            "  gb market bots\n"
            "  gb market deploy\n"
            "  gb market pack\n"
            "  gb stack"
        ),
    )
    return HANDLERS[name](args)


if __name__ == "__main__":
    main(body)
