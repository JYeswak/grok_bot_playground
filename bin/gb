        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="gatesdoc")


def cmd_readme(a: ReadmeArgs) -> int:
    """Pass through to `bin/gb-readme.py` — the public README's factual half, derived.

    Bare `gb readme` CHECKS and exits 1 when stale, rather than silently regenerating. A
    generator whose default action is to rewrite the file cannot be used as a gate, because
    running the check would make the check pass.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-readme.py")]
    if a.selftest:
        argv.append("--selftest")
    elif a.write:
        argv.append("--write")
    elif a.json:
        argv.append("--json")
    else:
        # `--check` is also the bare default. It was DOCUMENTED on ReadmeArgs and absent from
        # the dataclass, so `gb readme --check` died with `unrecognized arguments` while the
        # docstring three hundred lines up promised it — found by a live Linux sweep in
        # another window on 2026-09-12, not by any gate here. A flag a doc names and argparse
        # has never heard of is the cheapest possible lie and nothing in this tree caught it.
        argv.append("--check")
    # It runs every producer's selftest to build the table, so the budget is the sum of them.
    return _passthrough(argv, budget_s=1800, label="readme")


def cmd_advise(a: AdviseArgs) -> int:
    """Pass through to `bin/gb-advise.py` — what to do next, ranked, with its evidence.

    Every ranked action carries the GATES.md row that justifies it. Evidence recovery was
    18 of 25 checks until tonight — seven actions were being emitted with nothing behind them —
    and the payload now reports `gates_evidence` in BOTH the normal and the blind envelope, so
    a consumer cannot KeyError its way into believing coverage is fine.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-advise.py")]
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=600, label="advise")


def cmd_x(a: XArgs) -> int:
    """Pass through to `bin/gb-x-sweep.py` — the practitioner corpus, ranked by authors.

    Defaults to `reclassify`, the OFFLINE action, on purpose: the default invocation of a verb
    should not be able to spend a rate-limited allowance. `collect` is the live one and honours
    `--max-calls`; a sweep that hits its ceiling reports the ceiling rather than silently
    returning a short corpus, because `has_more=True` on every query means no run here has ever
    seen the population.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-x-sweep.py"), a.action]
    if a.action == "reclassify":
        # SELECT BY MEASUREMENT, NOT BY FILENAME. Two heuristics were tried and both were
        # wrong, in opposite directions:
        #
        #   "newest"  -> x/2026-09-12T0024.json, reporting 453 uses / 415 authors
        #   "largest" -> x/2026-09-12T0024.json again (1,401 posts vs the corpus's 1,356)
        #   measured  -> x/2026-09-11T1753.json, reporting 487 uses / 448 authors
        #
        # The newest AND larger artifact yields FEWER uses, because it is a daily link harvest
        # whose queries were not hunting use descriptions. No property of a filename or a byte
        # count can see that. So the verb RUNS the offline classifier on each candidate — zero
        # search calls, ~1s apiece — and picks the pair that actually yields the most
        # use-describing posts, then prints the whole table so the loser is visible too.
        #
        # This is the fifth time tonight a derived read beat the measurement and lost.
        art = sorted(ROOT.glob("x/*.json"))
        plain = [p for p in art if ".sweep." not in p.name]
        sweeps = [p for p in art if ".sweep." in p.name]
        if not plain or not sweeps:
            print(
                "gb x reclassify: needs one plain and one .sweep. artifact under x/ — "
                "run `gb x collect` first",
                file=sys.stderr,
            )
            return 3
        sweep = sweeps[-1]
        scored: List[Tuple[int, pathlib.Path]] = []
        for cand in plain:
            probe = subprocess.run(
                [
                    sys.executable,
                    str(BIN / "gb-x-sweep.py"),
                    "reclassify",
                    "--first-pass",
                    str(cand),
                    "--sweep",
                    str(sweep),
                    "--json",
                ],
                capture_output=True,
                text=True,
                timeout=300,
            )
            uses = 0
            try:
                env = json.loads(probe.stdout or "{}")
                uses = int(
                    (env.get("result") or env).get("combined", {}).get("total_uses") or 0
                )
            except (ValueError, AttributeError, TypeError):
                uses = 0  # an unparseable probe scores zero; it does not win by accident
            scored.append((uses, cand))
        scored.sort()
        for uses, cand in scored:
            mark = "->" if cand is scored[-1][1] else "  "
            print(f"  {mark} {cand.name}  {uses} use(s)", file=sys.stderr)
        best = scored[-1][1]
        print(
            f"gb x: joining {best.name} + {sweep.name} — chosen by MEASURED uses, "
            f"not by date or size",
            file=sys.stderr,
        )
        argv += ["--first-pass", str(best), "--sweep", str(sweep)]
    if a.action == "fetch":
        # gb-x.py is a different producer from gb-x-sweep.py behind this verb:
        # quota is spent by default, the artifact is written only with --apply.
        fargv: List[str] = [sys.executable, str(BIN / "gb-x.py"), "collect"]
        if not a.apply:
            fargv.append("--dry-run")
        if a.max_calls is not None:
            fargv += ["--max-calls", str(a.max_calls)]
        if a.json:
            fargv.append("--json")
        return _passthrough(fargv, budget_s=900, label="x fetch")
        argv += ["--max-calls", str(a.max_calls)]
    if a.dry_run:
        argv.append("--dry-run")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=3600, label="x")


def cmd_post(a: PostArgs) -> int:
    """Pass through to `bin/gb-post.py` — the only surface here that publishes anything.

    Budget is generous because `draft` RUNS every claim's command, and some of those are live
    account reads. That cost is the product: a post nobody verified is worth less than no post.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-post.py"), a.action]
    if a.action == "record":
        if not a.ids:
            print(
                "gb post record: pass --ids id1,id2 — recording is opt-in per claim, never a "
                "bulk publish of whatever happened to verify",
                file=sys.stderr,
            )
            return 2
        argv += ["--ids", *[s.strip() for s in a.ids.split(",") if s.strip()]]
    if a.limit is not None:
        argv += ["--limit", str(a.limit)]
    if a.out:
        argv.append("--out")
    if a.include_published:
        argv.append("--include-published")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=1800, label="post")


def cmd_roadmap(a: RoadmapArgs) -> int:
    """Pass through to `bin/gb-gaps.py` — what is still open, re-proved every run.

    Exit 1 means open gaps exist, which is the normal state of a live product and not an
    error. Exit 2 means at least one PROBE could not decide — a broken probe is a defect in
    the ledger, and it ranks above any gap it was meant to measure.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-gaps.py")]
    if a.detail:
        argv.append("--detail")
    if a.json:
        argv.append("--json")
    return _passthrough(argv, budget_s=1200, label="roadmap")


def cmd_mcp(a: McpArgs) -> int:
    """Pass through to `bin/gb-mcp.py` — the MCP in-app half, receipted."""
    argv: List[str] = [sys.executable, str(BIN / "gb-mcp.py")]
    if a.json:
        argv.append("--json")
    argv.append(a.action)
    if a.action == "add":
        if not a.target:
            print("gb: mcp add needs a URL", file=sys.stderr)
            return EXIT_USAGE
        argv.append(a.target)
        if a.name:
            argv += ["--name", a.name]
    elif a.action in ("tools", "allowlist"):
        if not a.target:
            print(f"gb: mcp {a.action} needs a server name", file=sys.stderr)
            return EXIT_USAGE
        argv.append(a.target)
        if a.action == "allowlist":
            # gbargs has no variadic positional: `gb mcp allowlist srv k1 k2`
            # lands k1/k2 in tool/args_json, so fold them into keep here.
            positional = [k for k in (a.tool, a.args_json) if k]
            if not positional and not a.keep:
                print("gb: mcp allowlist with nothing kept disables everything — "
                      "pass tools positionally or via --keep", file=sys.stderr)
                return EXIT_USAGE
            argv += positional
            for k in a.keep:
                argv += ["--keep-flag", k]
            if a.note:
                argv += ["--note", a.note]
    elif a.action == "call":
        if not (a.target and a.tool and a.args_json):
            print("gb: mcp call needs <server> <tool> '<json-args>'", file=sys.stderr)
            return EXIT_USAGE
        argv += [a.target, a.tool, a.args_json]
        if a.agent:
            argv += ["--agent", a.agent]
    elif a.action == "list":
        pass
    return _passthrough(argv, budget_s=300, label="mcp")

def cmd_bot(a: BotArgs) -> int:
    """Pass through to `bin/gb-bot.py` — Bot turns and readbacks, receipted."""
    argv: List[str] = [sys.executable, str(BIN / "gb-bot.py")]
    if a.json:
        argv.append("--json")
    if a.action == "send":
        if not (a.target and a.text):
            print("gb: bot send needs <bot> '<text>'", file=sys.stderr)
            return EXIT_USAGE
        argv += ["send", a.target, a.text]
    elif a.action == "read":
        if not a.target:
            print("gb: bot read needs <bot>", file=sys.stderr)
            return EXIT_USAGE
        argv += ["read", a.target]
    elif a.action == "resolve":
        if not a.target:
            print("gb: bot resolve needs <bot>", file=sys.stderr)
            return EXIT_USAGE
        argv += ["resolve", a.target]
    elif a.action == "log":
        if not a.target:
            print("gb: bot log needs <bot>", file=sys.stderr)
            return EXIT_USAGE
        argv += ["log", a.target, "--limit", str(a.limit)]
    elif a.action == "ask":
        if not (a.target and a.text):
            print("gb: bot ask needs <bot> '<text>'", file=sys.stderr)
            return EXIT_USAGE
        argv += ["ask", a.target, a.text, "--timeout", str(a.timeout)]
        if a.expect:
            argv += ["--expect", a.expect]
    # int, not float: `_passthrough` takes an int budget and `a.timeout` is a float, so the
    # sum widens. Truncating is correct here — the value is a deadline in seconds, and a
    # fractional second of process budget is not a distinction any caller can use.
    budget = 300 + int(a.timeout if a.action == "ask" else 0)
    return _passthrough(argv, budget_s=budget, label="bot")
def cmd_handover(a: HandoverArgs) -> int:
    """Pass through to `bin/gb-handover.py` — dry run unless --send (turns spend allowance)."""
    argv: List[str] = [sys.executable, str(BIN / "gb-handover.py")]
    if a.bot:
        argv += ["--bot", a.bot]
    if a.send:
        argv.append("--send")
    return _passthrough(argv, budget_s=300, label="handover")

def cmd_record(a: RecordArgs) -> int:
    """Pass through to `bin/gb-record-inventory.py` — the structured hand record."""
    argv: List[str] = [sys.executable, str(BIN / "gb-record-inventory.py")]
    if a.device:
        argv += ["--device", a.device]
    if a.root:
        argv += ["--root", a.root]
    if a.validate:
        argv += ["--validate", a.validate]
    elif a.list:
        argv.append("--list")
    elif a.template:
        argv.append("--template")
        if a.no_roster:
            argv.append("--no-roster")
    elif a.no_roster:
        argv.append("--no-roster")
    return _passthrough(argv, budget_s=120, label="record")

def cmd_matrix(a: MatrixArgs) -> int:
