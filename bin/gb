        argv.append("--json")
    return _passthrough(argv, budget_s=300, label="gatesdoc")


def cmd_readme(a: ReadmeArgs) -> int:
    """Pass through to `bin/gb-readme.py` — the public README's factual half, derived.

    Bare `gb readme` CHECKS and exits 1 when stale, rather than silently regenerating. A
    generator whose default action is to rewrite the file cannot be used as a gate, because
    running the check would make the check pass.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-readme.py")]
    if a.selftest:
        argv.append("--selftest")
    elif a.write:
        argv.append("--write")
    elif a.json:
        argv.append("--json")
    else:
        # `--check` is also the bare default. It was DOCUMENTED on ReadmeArgs and absent from
        # the dataclass, so `gb readme --check` died with `unrecognized arguments` while the
        # docstring three hundred lines up promised it — found by a live Linux sweep in
        # another window on 2026-09-12, not by any gate here. A flag a doc names and argparse
        # has never heard of is the cheapest possible lie and nothing in this tree caught it.
        argv.append("--check")
    # It runs every producer's selftest to build the table, so the budget is the sum of them.
    return _passthrough(argv, budget_s=1800, label="readme")


def cmd_advise(a: AdviseArgs) -> int:
    """Pass through to `bin/gb-advise.py` — what to do next, ranked, with its evidence.

    Every ranked action carries the GATES.md row that justifies it. Evidence recovery was
    18 of 25 checks until tonight — seven actions were being emitted with nothing behind them —
    and the payload now reports `gates_evidence` in BOTH the normal and the blind envelope, so
    a consumer cannot KeyError its way into believing coverage is fine.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-advise.py")]
    if a.json:
        argv.append("--json")
    if a.full:
        argv.append("--full")
    if a.limit is not None:
        argv += ["--limit", str(a.limit)]
    for s in a.source:
        argv += ["--source", s]
    if a.dry_run:
        argv.append("--dry-run")
    if a.selftest:
        argv.append("--selftest")
    return _passthrough(argv, budget_s=600, label="advise")

def cmd_research(a: ResearchArgs) -> int:
    """Relay over `bin/gb-research.py` — one question, receipted, budget-capped.

    Default depth (`sweep`) is disk+cache only and spends no network; live calls
    happen only at `deep`/`exhaustive` inside `--max-calls`. Budgets, packs and the
    tier gate are owned by the producer; this relay only forwards flags.
    """
    argv: List[str] = [sys.executable, str(BIN / "gb-research.py")]
    if a.question:
        argv.append(a.question)
    argv += ["--depth", a.depth]
    for s in a.source or []:
        argv += ["--source", s]
    if a.max_calls is not None:
        argv += ["--max-calls", str(a.max_calls)]
    if a.resume:
        argv += ["--resume", a.resume]
    if a.dry_run:
        argv.append("--dry-run")
    if a.json:
        argv.append("--json")
    if a.selftest:
        argv.append("--selftest")
    if a.capabilities:
        argv.append("--capabilities")
    budget = 600 if a.depth in ("deep", "exhaustive") else 120
    return _passthrough(argv, budget_s=budget, label="research")


