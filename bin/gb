@dataclasses.dataclass(frozen=True)
class XArgs:
    """What practitioners are ACTUALLY doing with Grok Bot, ranked by distinct authors.

    `bin/gb-x-sweep.py` holds the ONLY use-case classifier in this repo and was reachable by
    no verb and shipped to nobody — the same double-dead defect as `advise`, found the same
    way. It produced 487 use-describing posts from 448 distinct authors (442 authored), and
    that number could not be re-derived through the CLI at all.

    Ranking is by DISTINCT AUTHORS, never by post count or engagement. Measured 2026-09-11:
    ranking by citations made one account talking to itself (`alltoolsverse`, 5x) look like a
    market, and an 866k-impression row I cited turned out to belong to a different @mattyp
    post about moving to San Francisco. `authored` excludes relays; in `agent-orchestration`
    that is the difference between 43 and 38, because all five relays are one SpaceXAI
    engineer. Cite the authored number.

    `reclassify` is OFFLINE — zero search calls, ~1s — so any figure here is reproducible
    without spending the rate limit, which is what makes it quotable.
    """

    action: str = arg(
        default="reclassify",
        help="reclassify (offline, from artifacts) | collect (live search) | matrix | fetch (gb-x.py firehose)",
        choices=["reclassify", "collect", "matrix", "fetch"],
        positional=True,
    )
