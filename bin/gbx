#!/usr/bin/env python3
"""gbx — deploy a Grok Bot from a template, and verify the steps the API will not do for you.

    gbx list                          what is available, and which measured gap it fills
    gbx show <template>               the identity, skills and manual steps before you commit
    gbx validate                      schema + skill-routing check across every template
    gbx new <template> [--deploy]     dry run by default; --deploy creates the Bot for real
    gbx doctor [<template>]           re-read the account: did the manual steps actually land
    gbx secret set NAME               store a key in the OS keychain and print where it goes

WHAT IS AUTOMATED, AND WHAT IS NOT. Measured against the live API, not assumed:

    create a Bot with durable identity   CreateGrokBotAgentFromTemplate   automated
    name / title / description / avatar  UpdateGrokBotAgent               automated
    skills                               travel in the template           automated
    install a connector                  no RPC exists                    printed, then verified
    create a routine                     automations are read-only        printed, then verified
    store a secret                       deliberately not automated       keychain + secret card

`doctor` exists because "I did the manual steps" is a claim, and a claim about your own account
is checkable. It re-reads the roster, the plugin installs and the routines, and reports which
steps landed rather than trusting the tick-box.

No key is ever written to disk by this tool, printed in full, or sent in a chat message. It
reuses the desktop app's signed-in session the same way the app does.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request
import uuid

HERE = pathlib.Path(__file__).resolve().parent
LIB = HERE.parent
TEMPLATES = LIB / "templates"
HOST = "api2.cursor.sh"
SERVICE = "aiserver.v1.GrokBotService"
DASH = "aiserver.v1.DashboardService"
# The neutral seed this library instantiates from. A Bot created from a third-party marketplace
# template inherits that author's terms and lineage; seeding from our own keeps it clean.
SEED_ENV = "GBX_SEED_SHARE_ID"


# ---------------------------------------------------------------- session + transport

KEYCHAIN = ("Grok Bot Safe Storage", "Grok Bot Key")
SUPPORT = pathlib.Path(os.path.expanduser("~/Library/Application Support/Grok Bot"))


def access_token() -> str:
    """Reuse the desktop app's own signed-in session rather than asking you for a key.

    The app stores its Cursor access token in `sand-secrets.json`, encrypted with Chromium's
    safeStorage scheme: a keychain password stretched with PBKDF2-SHA1 (1003 iterations, salt
    "saltysalt") into an AES-128-CBC key, IV of 16 spaces, `v10` prefix. This reads it the same
    way the app does.

    macOS will show a keychain prompt the first time. That prompt is the point: this tool cannot
    read your session without you allowing it, and it never writes the token anywhere.
    """
    if sys.platform != "darwin":
        raise SystemExit("gbx: session reuse is implemented for macOS only so far")
    r = subprocess.run(["security", "find-generic-password", "-w", "-s", KEYCHAIN[0],
                        "-a", KEYCHAIN[1]], capture_output=True, text=True, timeout=180)
    if r.returncode != 0 or not r.stdout.strip():
        raise SystemExit("gbx: could not read the Grok Bot keychain entry — click Allow on the "
                         "macOS prompt and re-run, or confirm the desktop app is signed in")
    key = hashlib.pbkdf2_hmac("sha1", r.stdout.strip().encode(), b"saltysalt", 1003, 16)
    try:
        from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    except ImportError:
        raise SystemExit("gbx: needs `cryptography` (pip install cryptography)")
    secrets = json.loads((SUPPORT / "sand-secrets.json").read_text())
    accounts = json.loads(secrets["cursor-accounts"])
    blob = accounts["accounts"][accounts["active"]]["cursor-access-token"]
    raw = base64.b64decode(blob)
    if raw[:3] != b"v10":
        raise SystemExit("gbx: unexpected secret format — the client changed its storage scheme")
    dec = Cipher(algorithms.AES(key), modes.CBC(b" " * 16)).decryptor()
    out = dec.update(raw[3:]) + dec.finalize()
    return out[: -out[-1]].decode("utf-8", "replace")


def rpc(token: str, method: str, body: dict, service: str = SERVICE) -> tuple[int, dict | str]:
    req = urllib.request.Request(
        f"https://{HOST}/{service}/{method}", data=json.dumps(body).encode(), method="POST",
        headers={"authorization": f"Bearer {token}", "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", "replace")[:300]
    except Exception as e:
        return 0, f"{type(e).__name__}: {e}"


# ---------------------------------------------------------------- templates

def parse_yaml(text: str) -> dict:
    """The template subset: scalars, `[a, b]` lists, `- item` lists, and `|` blocks. A YAML
    dependency for four shapes would make this library harder to install than the Bots it
    deploys."""
    out: dict = {}
    key, block, listing = None, [], None
    for raw in text.splitlines():
        if raw.startswith(("  - ", "- ")) and listing:
            out[listing].append(raw.split("- ", 1)[1].strip().strip('"'))
            continue
        if key and (raw.startswith("  ") or not raw.strip()):
            block.append(raw[2:] if raw.startswith("  ") else "")
            continue
        if key:
            out[key] = "\n".join(block).strip()
            key, block = None, []
        if not raw.strip() or raw.lstrip().startswith("#") or ":" not in raw:
            continue
        k, v = raw.split(":", 1)
        k, v = k.strip(), v.split(" #")[0].strip()
        listing = None
        if v == "|":
            key = k
        elif v.startswith("[") and v.endswith("]"):
            out[k] = [x.strip() for x in v[1:-1].split(",") if x.strip()]
        elif v == "":
            out[k], listing = [], k
        else:
            out[k] = v.strip('"')
    if key:
        out[key] = "\n".join(block).strip()
    return out


def load_template(name: str) -> dict:
    d = TEMPLATES / name
    if not (d / "bot.yaml").is_file():
        raise SystemExit(f"gbx: no template {name!r} (see `gbx list`)")
    t = parse_yaml((d / "bot.yaml").read_text())
    t["_dir"], t["_slug"] = d, name
    t["_skills"] = sorted(p for p in d.glob("skills/*/SKILL.md"))
    return t


def all_templates() -> list[dict]:
    return [load_template(p.name) for p in sorted(TEMPLATES.iterdir()) if p.is_dir()]


def validate_one(t: dict) -> list[str]:
    bad = []
    for field in ("name", "title", "gap", "evidence", "description"):
        if not t.get(field):
            bad.append(f"{t['_slug']}: missing {field}")
    if len(t.get("description", "")) < 200:
        bad.append(f"{t['_slug']}: description under 200 chars — a Bot's charter IS its behaviour")
    if "Approval boundary" not in t.get("description", ""):
        bad.append(f"{t['_slug']}: description states no approval boundary")
    if not t["_skills"]:
        bad.append(f"{t['_slug']}: no skills")
    for s in t["_skills"]:
        txt = s.read_text()
        if not txt.startswith("---"):
            bad.append(f"{t['_slug']}/{s.parent.name}: no frontmatter")
            continue
        fm = txt.split("---", 2)[1]
        desc = next((l.split("description:", 1)[1] for l in fm.splitlines()
                     if l.startswith("description:")), "")
        # The RULE is "a reader can tell when to route here", not a magic phrase. Caught by this
        # validator on its own library: `daily-brief` says "Use every weekday morning on a
        # schedule, or when asked ..." — which satisfies the rule while failing a literal
        # `use when` match. Fixed the check rather than reworded a correct description.
        if not re.search(r"\buse (when|if|every|each|before|after|on|at|for)\b", desc, re.I):
            bad.append(f"{t['_slug']}/{s.parent.name}: description does not say WHEN to use it")
    return bad


# ---------------------------------------------------------------- commands

def cmd_list(_args) -> int:
    for t in all_templates():
        print(f"{t['_slug']:<22}{t['name']:<20}{len(t['_skills'])} skill(s)  "
              f"connectors={','.join(t.get('connectors') or []) or 'none'}")
        print(f"{'':<22}gap: {t['gap']}")
    return 0


def cmd_show(args) -> int:
    t = load_template(args.template)
    print(f"# {t['name']} — {t['title']}\n\ngap: {t['gap']}\nevidence: {t['evidence']}\n")
    print(t["description"])
    print("\nskills: " + ", ".join(s.parent.name for s in t["_skills"]))
    print("manual steps after deploy:")
    for s in t.get("manual_steps") or ["(none)"]:
        print(f"  - {s}")
    return 0


def cmd_validate(_args) -> int:
    bad = [b for t in all_templates() for b in validate_one(t)]
    if bad:
        print(f"INVALID — {len(bad)} problem(s):")
        for b in bad:
            print(f"  - {b}")
        return 1
    print(f"valid: {len(all_templates())} template(s) pass schema and skill-routing checks")
    return 0


def cmd_new(args) -> int:
    t = load_template(args.template)
    bad = validate_one(t)
    if bad:
        print("refusing to deploy an invalid template:")
        for b in bad:
            print(f"  - {b}")
        return 1
    if not args.deploy:
        print(f"DRY RUN — would create Bot {t['name']!r} ({t['title']}) with "
              f"{len(t['_skills'])} skill(s) and a {len(t['description'])}-char charter.")
        print("add --deploy to create it for real. Manual steps afterwards:")
        for s in t.get("manual_steps") or ["(none)"]:
            print(f"  - {s}")
        return 0

    seed = __import__("os").environ.get(SEED_ENV)
    if not seed:
        print(f"gbx: set {SEED_ENV} to your own seed template's share id.\n"
              f"  Make one once: any Bot -> Share as template -> copy the share link's id.\n"
              f"  Seeding from your own template avoids inheriting a third party's terms.")
        return 78
    token = access_token()
    st, r = rpc(token, "CreateGrokBotAgentFromTemplate",
                {"share_id": seed, "agent_id": str(uuid.uuid4())})
    if st != 200 or not isinstance(r, dict):
        print(f"gbx: create failed {st} {str(r)[:160]}")
        return 1
    agent = r.get("agent") or {}
    st2, r2 = rpc(token, "UpdateGrokBotAgent", {
        "id": agent.get("id"), "name": t["name"], "title": t["title"],
        "description": t["description"]})
    if st2 != 200:
        print(f"gbx: created {agent.get('id')} but could not shape it: {st2} {str(r2)[:160]}")
        return 1
    print(f"created and shaped: {t['name']} (id {agent.get('id')})")
    print("now do these by hand — no API exists for them:")
    for s in t.get("manual_steps") or ["(none)"]:
        print(f"  - {s}")
    print("then run `gbx doctor` to check they landed.")
    return 0


def cmd_doctor(args) -> int:
    token = access_token()
    st, r = rpc(token, "ListGrokBotAgents", {})
    roster = {a["name"]: a for a in ((r or {}).get("agents") or [])} if st == 200 else {}
    st2, pl = rpc(token, "ListUserPluginInstalls", {}, service=DASH)
    installed = {(i.get("plugin") or {}).get("name") for i in ((pl or {}).get("installs") or [])}
    ts = [load_template(args.template)] if args.template else all_templates()
    rc = 0
    for t in ts:
        bot = roster.get(t["name"])
        print(f"\n{t['name']}")
        if not bot:
            print("  MISSING — not on the roster (gbx new <template> --deploy)")
            rc = 1
            continue
        desc_ok = len(bot.get("description") or "") >= 200
        print(f"  {'ok  ' if desc_ok else 'THIN'} charter {len(bot.get('description') or '')} chars")
        rc |= 0 if desc_ok else 1
        for c in t.get("connectors") or []:
            have = c in installed
            print(f"  {'ok  ' if have else 'TODO'} connector {c}")
            rc |= 0 if have else 1
        sta, au = rpc(token, "ListGrokBotAgentAutomations", {"agent_id": bot["id"]})
        n = len(((au or {}).get("automations") or [])) if sta == 200 else 0
        wants_routine = any("routine" in s.lower() for s in (t.get("manual_steps") or []))
        if wants_routine:
            print(f"  {'ok  ' if n else 'TODO'} routine(s): {n}")
            rc |= 0 if n else 1
    return rc


def cmd_secret(args) -> int:
    """Keychain, then the Bot's secret card. Never this repo, never a chat message."""
    name = args.name
    print(f"1. store it locally (you will be prompted; the value is not echoed):")
    print(f"     security add-generic-password -a \"$USER\" -s gbx:{name} -w -U")
    print(f"2. read it back when you need to paste it:")
    print(f"     security find-generic-password -a \"$USER\" -s gbx:{name} -w")
    print(f"3. give it to the Bot via **Settings -> secret card**, never by pasting into chat —")
    print(f"   a key in a chat message is in the transcript, the replica, and any share link.")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="gbx", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    sh = sub.add_parser("show"); sh.add_argument("template"); sh.set_defaults(fn=cmd_show)
    sub.add_parser("validate").set_defaults(fn=cmd_validate)
    nw = sub.add_parser("new"); nw.add_argument("template")
    nw.add_argument("--deploy", action="store_true"); nw.set_defaults(fn=cmd_new)
    dr = sub.add_parser("doctor"); dr.add_argument("template", nargs="?"); dr.set_defaults(fn=cmd_doctor)
    sc = sub.add_parser("secret"); sc.add_argument("action", choices=["set"])
    sc.add_argument("name"); sc.set_defaults(fn=cmd_secret)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
